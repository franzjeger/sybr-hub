# ── Sybr HUB systemd unit ───────────────────────────────────────────────────
#
# Install:
#   sudo cp scripts/sybr-hub.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sybr-hub
#
# Edit the User/Group/WorkingDirectory placeholders below to match your
# install before enabling. The unit deliberately does NOT run as root — see
# "VPN and privileged commands" at the bottom for the small set of commands
# that need elevation and how to grant just those.

[Unit]
Description=Sybr HUB — read-mostly aggregator for MSP technicians
Documentation=https://github.com/franzjeger/sybr-hub
After=network-online.target
Wants=network-online.target

# Crash-loop backstop for the in-app self-update. Restart=on-failure below would
# otherwise restart a bad deploy every 5s forever; the updater import-smokes new
# code and rolls back before re-exec, but a *runtime* failure it cannot catch (a
# broken startup migration, a key it can no longer unwrap) would loop silently.
# After 5 failed starts in 3 minutes systemd gives up and parks the unit in a
# visible 'failed' state instead — recovery is then the manual git reset in
# docs/UPGRADING.md. Well clear of the ~1 legitimate restart a real re-exec costs.
StartLimitIntervalSec=180
StartLimitBurst=5

[Service]
Type=exec

# ── Identity ────────────────────────────────────────────────────────────────
# Create a dedicated account; do not reuse a login user.
#   sudo useradd --system --home /opt/sybr-hub --shell /usr/sbin/nologin sybrhub
User=sybrhub
Group=sybrhub

WorkingDirectory=/opt/sybr-hub
ExecStart=/opt/sybr-hub/.venv/bin/python /opt/sybr-hub/main.py

Restart=on-failure
RestartSec=5s

# ── Configuration ───────────────────────────────────────────────────────────
# Bind to localhost and terminate TLS at a reverse proxy, or set the two
# SSL_* variables below and expose this directly. Do not do neither: the app
# serves plain HTTP when no certificate is configured.
Environment=SYBR_HUB_HOST=127.0.0.1
Environment=SYBR_HUB_PORT=8099
Environment=SYBR_HUB_LOG_LEVEL=INFO

# Serve HTTPS directly — both must be set, or neither.
#Environment=SYBR_HUB_SSL_CERT=/etc/ssl/certs/sybr-hub.pem
#Environment=SYBR_HUB_SSL_KEY=/etc/ssl/private/sybr-hub.key

# Data and config locations. Default to XDG paths under the service user's
# home; set explicitly so a home-directory change cannot silently relocate
# the database and the encrypted customer files.
Environment=MSP_DATA_DIR=/var/lib/sybr-hub
Environment=MSP_CONFIG_DIR=/etc/sybr-hub
# systemd defaults HOME to WorkingDirectory, which ProtectSystem=strict
# makes read-only. PowerShell creates ~/.cache/powershell before it parses
# its arguments, so the setup wizard died with
#   IOException: Read-only file system : '/opt/sybr-hub/.cache/powershell'
# and exit code -6, long before any script ran. Install-Module
# -Scope CurrentUser lands under $HOME too, so this covers both.
Environment=HOME=/var/lib/sybr-hub/home

# Protect local master-key backups with an operator-managed secret. Generate a
# random value (for example `openssl rand -base64 48`) at the path below in a
# root-only secret directory. The CachyOS installer creates it automatically.
# systemd exposes a private read-only copy to the service. Do not store the
# source beside MSP_DATA_DIR or MSP_CONFIG_DIR.
# Keep an offline copy: losing both this secret and the exported master key
# makes the encrypted customer data unrecoverable after a host rebuild.
LoadCredential=key-wrap.secret:/etc/sybr-hub-secrets/key-wrap.secret
Environment=SYBR_KEY_WRAP_SECRET_FILE=%d/key-wrap.secret

# Stable identifier for Guacamole cleanup ownership. Keep this unchanged over
# host renames/rebuilds so startup can remove JDBC connections left by a crash.
#Environment=SYBR_GUAC_INSTANCE_ID=sybr-hub-production

# SQLite connections held open per event loop. 5 is the default and is
# ample for a single-operator install; raise only if you see requests
# queueing on the pool.
#Environment=MSP_DB_POOL_SIZE=5

# PowerShell 7, required for the Exchange Online audit section and first-run
# app registration. Only needed if pwsh is not on PATH.
#Environment=PWSH_PATH=/opt/microsoft/powershell/7/pwsh

# ── Hardening ───────────────────────────────────────────────────────────────
# This process holds customer credentials, an encryption master key and live
# VPN tunnels into customer networks. Constrain it accordingly.
NoNewPrivileges=yes
UMask=0077
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
# Must stay 'no': pwsh is .NET and its JIT needs W-then-X mappings. With
# yes, pwsh dies with SIGSEGV inside libcoreclr.so and no legible error.
MemoryDenyWriteExecute=no
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# ProtectSystem=strict makes everything read-only; grant back only what the
# app writes: the database, encrypted customer configs, audit output, and — for
# the in-app self-update (Settings → Update now) — its own checkout, so the
# admin-triggered `git pull` + re-exec can rewrite the code it runs. This is the
# one place the code directory is writable by the service; it is the inherent
# cost of an app that can update itself. It does NOT relax NoNewPrivileges: the
# update re-execs in place (os.execv) rather than calling systemctl. Drop
# /opt/sybr-hub from this line to keep the code read-only and update by hand.
ReadWritePaths=/var/lib/sybr-hub /etc/sybr-hub /opt/sybr-hub
#ReadWritePaths=/srv/sybr-hub-audits          # if audit_dir is set elsewhere

[Install]
WantedBy=multi-user.target

# ── VPN and privileged commands ─────────────────────────────────────────────
#
# NoNewPrivileges=yes deliberately prevents *all* privilege elevation,
# including sudo even when sudoers says NOPASSWD. Do not weaken that boundary
# or grant sudo tee/ip to this web process: a web-app compromise would become
# root. Under this hardened unit, establish customer tunnels outside Sybr HUB
# (or through a separately authenticated, narrowly scoped privileged helper)
# and let the hub consume the resulting routes/interfaces. The API exposes
# this as mode=external and the UI disables Connect instead of trying commands
# that cannot succeed; the rest of the hub is unaffected.
#
# ── Hardening vs. VPN ───────────────────────────────────────────────────────
# Creating tunnel interfaces needs privileges the sandbox above withholds.
# PrivateDevices and RestrictAddressFamilies are additional boundaries, but
# relaxing them alone is not sufficient while NoNewPrivileges stays enabled.
# Treat a privileged VPN helper as a separate component and threat boundary;
# do not turn the web service itself into that helper.
