<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>M365 + Azure Audit Report — {{ customer_name }}</title>
  <style>
    {% include 'styles.css' %}
  </style>
</head>
<body>

{# ── Cover ──────────────────────────────────────────────────────────────────── #}
<div class="cover">
  <h1>M365 + Azure Security Audit</h1>
  <div class="subtitle">Full Tenant & Infrastructure Assessment</div>
  <div class="meta">
    <strong>Customer:</strong> {{ customer_name }}<br>
    <strong>Domain:</strong>   {{ org_domain }}<br>
    <strong>Date:</strong>     {{ report_date }}<br>
    <strong>Generated by:</strong> MSP Toolkit
  </div>
</div>

<div class="container">

{# ── Executive Summary ──────────────────────────────────────────────────────── #}
<h2>Executive Summary</h2>

<div class="summary-bar">
  <div class="summary-stat blue">
    <div class="number">{{ total_sections }}</div>
    <div class="label">Sections Run</div>
  </div>
  <div class="summary-stat green">
    <div class="number">{{ done_sections }}</div>
    <div class="label">Completed</div>
  </div>
  <div class="summary-stat orange">
    <div class="number">{{ warn_files | length }}</div>
    <div class="label">Warnings</div>
  </div>
  <div class="summary-stat {% if failed_sections > 0 %}red{% else %}green{% endif %}">
    <div class="number">{{ failed_sections }}</div>
    <div class="label">Failed</div>
  </div>
</div>

{# ── Warnings summary ───────────────────────────────────────────────────────── #}
{% if warn_files %}
<div class="alert alert-warn">
  <strong>{{ warn_files | length }} Warning File(s) Require Attention</strong>
  {% for w in warn_files %}
    <div>→ {{ w }}</div>
  {% endfor %}
</div>
{% endif %}

{# ── Defender Alerts ────────────────────────────────────────────────────────── #}
{% if defender_alerts and 'No active' not in defender_alerts %}
<div class="alert alert-danger">
  <strong>Active Microsoft Defender Alerts Detected</strong>
  <pre>{{ defender_alerts[:800] }}</pre>
</div>
{% endif %}

{# ── External Email Forwarding ──────────────────────────────────────────────── #}
{% if ext_fwd_warn %}
<div class="alert alert-danger">
  <strong>External Mailbox Forwarding Detected</strong>
  <pre>{{ ext_fwd_warn[:600] }}</pre>
</div>
{% endif %}

{# ── Inbox Rule External Fwd ────────────────────────────────────────────────── #}
{% if inbox_rule_warn %}
<div class="alert alert-danger">
  <strong>Inbox Rules Forwarding to External Addresses</strong>
  <pre>{{ inbox_rule_warn[:600] }}</pre>
</div>
{% endif %}

{# ── SPF/DMARC warnings ─────────────────────────────────────────────────────── #}
{% if spf_dmarc_warn %}
<div class="alert alert-warn">
  <strong>Email Authentication Issues (SPF/DMARC/DKIM)</strong>
  <pre>{{ spf_dmarc_warn[:800] }}</pre>
</div>
{% endif %}

{# ── Risky Users ────────────────────────────────────────────────────────────── #}
{% if risky_users and 'No risky' not in risky_users %}
<div class="alert alert-warn">
  <strong>Risky Users Detected (Identity Protection)</strong>
  <pre>{{ risky_users[:600] }}</pre>
</div>
{% endif %}

{# ── Section status table ───────────────────────────────────────────────────── #}
<h2>Audit Section Status</h2>
<table>
  <tr>
    <th>Status</th>
    <th>Section</th>
    <th>Files Saved</th>
    <th>Warnings</th>
  </tr>
  {% for r in results %}
  <tr>
    <td class="section-status">
      {% if r.status == SectionStatus.DONE %}
        <span title="Done">✓</span>
      {% elif r.status == SectionStatus.FAILED %}
        <span title="Failed">✗</span>
      {% elif r.status == SectionStatus.SKIPPED %}
        <span title="Skipped">→</span>
      {% else %}
        <span>?</span>
      {% endif %}
    </td>
    <td>{{ r.name }}</td>
    <td>{{ r.files | length }}</td>
    <td>
      {% if r.warns %}
        <span class="badge badge-yellow">{{ r.warns | length }} warn</span>
      {% endif %}
      {% if r.error %}
        <span class="badge badge-red" title="{{ r.error }}">error</span>
      {% endif %}
    </td>
  </tr>
  {% endfor %}
</table>

{# ── Tenant ─────────────────────────────────────────────────────────────────── #}
<h2>Tenant Information</h2>
<pre>{{ tenant_info }}</pre>

{# ── Licenses ───────────────────────────────────────────────────────────────── #}
<h2>Licenses</h2>
<pre>{{ license_info }}</pre>

{# ── Users ──────────────────────────────────────────────────────────────────── #}
<h2>Users</h2>
<pre>{{ user_count }}</pre>

{# ── Secure Score ───────────────────────────────────────────────────────────── #}
<h2>Microsoft Secure Score</h2>
<pre>{{ secure_score[:3000] }}</pre>

{# ── Conditional Access ─────────────────────────────────────────────────────── #}
<h2>Conditional Access Policies</h2>
<pre>{{ ca_policies }}</pre>

{# ── MFA ────────────────────────────────────────────────────────────────────── #}
<h2>MFA Status (All Enabled Members)</h2>
<pre>{{ mfa_methods[:4000] }}</pre>

{# ── Email Security ─────────────────────────────────────────────────────────── #}
<h2>Email Security (SPF / DKIM / DMARC)</h2>
{% set spf_data = file_contents.get('26_email_dns_spf_dmarc.txt', '') %}
<pre>{{ spf_data[:3000] }}</pre>

{# ── Azure Advisor ──────────────────────────────────────────────────────────── #}
{% if advisor_data %}
<h2>Azure Advisor Recommendations</h2>
<pre>{{ advisor_data[:3000] }}</pre>
{% endif %}

{# ── NSG ────────────────────────────────────────────────────────────────────── #}
{% if nsg_data %}
<h2>Azure Network Security Groups</h2>
<pre>{{ nsg_data[:3000] }}</pre>
{% endif %}

{# ── All raw data sections ──────────────────────────────────────────────────── #}
<h2>Full Raw Data</h2>
<p style="color:#718096;font-size:12px;margin-bottom:16px;">
  All collected data files — identical to the raw .txt output in the audit folder.
</p>

{% for filename, content in file_contents.items() | sort %}
  {% if 'WARN' not in filename.upper() %}
  <h3>{{ filename }}</h3>
  <pre>{{ content[:5000] }}{% if content | length > 5000 %}
... [truncated — see full file in audit folder]{% endif %}</pre>
  {% endif %}
{% endfor %}

{# ── Warning files full content ─────────────────────────────────────────────── #}
{% if warn_files %}
<h2>Warning Details</h2>
{% for wf in warn_files %}
  <h3>{{ wf }}</h3>
  <div class="alert alert-warn">
    <pre>{{ file_contents.get(wf, '') }}</pre>
  </div>
{% endfor %}
{% endif %}

<div class="report-footer">
  MSP Toolkit — Audit Report for {{ customer_name }} — {{ report_date }} —
  Generated from {{ out_dir }}
</div>

</div>{# /container #}
</body>
</html>
