<!-- ── 2. Key Findings ── -->
<div class="section-label" id="funn">{{ t.what_we_found }}</div>
<h2><a href="#funn" class="section-anchor">{{ t.key_findings }}</a></h2>
<p class="section-intro">{{ t.key_findings_intro }}</p>

<!-- MFA -->
{% if not mfa.has_data %}
<div class="finding warning" id="finding-mfa">
  <div class="finding-icon">&#x26A0;&#xFE0F;</div>
  <div class="finding-body">
    <h4>{{ t.mfa_data_missing_finding }}</h4>
    <p>{{ t.mfa_data_missing_desc }}</p>
  </div>
  <div class="finding-badge"><span class="badge warning">{{ t.data_unavailable }}</span></div>
</div>
{% elif mfa.no_mfa > 0 %}
<div class="finding critical" id="finding-mfa">
  <div class="finding-icon">&#x1F513;</div>
  <div class="finding-body">
    <h4>{{ t('mfa_missing_title', count=mfa.no_mfa) }}</h4>
    <p>{{ t.mfa_missing_desc }}</p>
    {% set unprotected = mfa.users | selectattr("protected", "false") | list %}
    {% if unprotected %}
    <div class="mfa-toggle" onclick="this.classList.toggle('open');this.nextElementSibling.classList.toggle('open')">
      <span class="arrow">&#x25B6;</span> {{ t('show_n_unprotected', count=unprotected|length) }}
    </div>
    <div class="mfa-drilldown">
      <table>
        <thead>
          <tr><th>{{ t.user }}</th><th>{{ t.email_upn }}</th><th>{{ t.mfa_registered }}</th><th>{{ t.ca_coverage }}</th><th>{{ t.reason }}</th></tr>
        </thead>
        <tbody>
        {% for u in unprotected %}
          <tr>
            <td><strong>{{ u.name }}</strong></td>
            <td style="font-size:11px;color:var(--muted);">{{ u.upn }}</td>
            <td><span class="tag tag-no">{{ t.no_word }}</span></td>
            <td><span class="tag {% if u.ca_excluded %}tag-no{% else %}tag-no{% endif %}">{% if u.ca_excluded %}{{ t.excluded }}{% else %}{{ t.no_word }}{% endif %}</span></td>
            <td style="font-size:11px;color:var(--muted);">{% if u.ca_excluded %}{{ t.excluded_from_ca }}{% else %}{{ t.no_mfa_no_ca }}{% endif %}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
    {% if finding_to_recs.get('finding-mfa') %}{% for ri in finding_to_recs['finding-mfa'] %}<a href="#rec-{{ ri }}" class="finding-rec-link">→ {{ t('see_recommendation', num=ri) }}</a> {% endfor %}{% endif %}
  </div>
  <div class="finding-badge"><span class="badge critical">{{ t.critical }}</span></div>
</div>
{% else %}
<div class="finding ok">
  <div class="finding-icon">&#x2705;</div>
  <div class="finding-body">
    <h4>{{ t.mfa_ok_title }}</h4>
    <p>{{ t('mfa_ok_desc', covered=mfa.covered, total=mfa.total) }}</p>
  </div>
  <div class="finding-badge"><span class="badge ok">{{ t.ok }}</span></div>
</div>
{% endif %}

<!-- External forwarding -->
{% if ext_fwd_warn and ext_fwd_warn.strip() %}
{% set fwd_entries = [] %}
{% for line in ext_fwd_warn.splitlines() %}
  {% if '→' in line %}
    {% set _ = fwd_entries.append(line.strip()) %}
  {% endif %}
{% endfor %}
<div class="finding critical" id="finding-fwd">
  <div class="finding-icon">&#x1F4E4;</div>
  <div class="finding-body">
    <h4>{{ t('ext_fwd_title', count=fwd_entries|length) }}</h4>
    <p>{{ t.ext_fwd_desc }}</p>
    {% if fwd_entries %}
    <div class="mfa-toggle" onclick="this.classList.toggle('open');this.nextElementSibling.classList.toggle('open')">
      <span class="arrow">&#x25B6;</span> {{ t('show_n_forwarding', count=fwd_entries|length) }}
    </div>
    <div class="mfa-drilldown">
      <table>
        <thead><tr><th style="width:40%;">{{ t.mailbox }}</th><th style="width:60%;">{{ t.forwarded_to }}</th></tr></thead>
        <tbody>
        {% for entry in fwd_entries %}
          {% set parts = entry.split('→') %}
          <tr>
            <td><strong>{{ parts[0].strip() }}</strong></td>
            <td style="font-size:12px;color:var(--muted);">{{ parts[1].strip().replace('smtp:', '').replace('SMTP:', '') if parts | length > 1 else '' }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
    {% if finding_to_recs.get('finding-fwd') %}{% for ri in finding_to_recs['finding-fwd'] %}<a href="#rec-{{ ri }}" class="finding-rec-link">→ {{ t('see_recommendation', num=ri) }}</a> {% endfor %}{% endif %}
  </div>
  <div class="finding-badge"><span class="badge critical">{{ t.critical }}</span></div>
</div>
{% endif %}

<!-- Risky users -->
{% if risky_users and 'No risky' not in risky_users and 'not available' not in risky_users.lower() and risky_users.strip() %}
{% set risky_entries = [] %}
{% for line in risky_users.splitlines() %}
  {% set l = line.strip() %}
  {% if l and not l.startswith('=') and not l.startswith('-') and 'UPN' not in l and 'RISKY' not in l %}
    {% set cols = l.split('  ') | reject('equalto', '') | list %}
    {% if cols | length >= 3 %}
      {% set _ = risky_entries.append({'upn': cols[0].strip(), 'level': cols[1].strip(), 'state': cols[2].strip()}) %}
    {% endif %}
  {% endif %}
{% endfor %}
<div class="finding warning" id="finding-risky">
  <div class="finding-icon">&#x26A0;&#xFE0F;</div>
  <div class="finding-body">
    <h4>{{ t('risky_users_title', count=risky_entries|length if risky_entries else '') }}</h4>
    <p>{{ t.risky_users_desc }}</p>
    {% if risky_entries %}
    <div class="mfa-toggle" onclick="this.classList.toggle('open');this.nextElementSibling.classList.toggle('open')">
      <span class="arrow">&#x25B6;</span> {{ t('show_n_risky', count=risky_entries|length) }}
    </div>
    <div class="mfa-drilldown">
      <table>
        <thead><tr><th style="width:50%;">{{ t.user }}</th><th style="width:25%;">{{ t.risk_level }}</th><th style="width:25%;">{{ t.status }}</th></tr></thead>
        <tbody>
        {% for u in risky_entries %}
          <tr>
            <td style="font-size:12px;">{{ u.upn }}</td>
            <td><span class="tag {% if u.level == 'high' %}tag-no{% else %}tag-yes{% endif %}">{{ u.level }}</span></td>
            <td style="font-size:12px;">{{ u.state }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
    {% if finding_to_recs.get('finding-risky') %}{% for ri in finding_to_recs['finding-risky'] %}<a href="#rec-{{ ri }}" class="finding-rec-link">→ {{ t('see_recommendation', num=ri) }}</a> {% endfor %}{% endif %}
  </div>
  <div class="finding-badge"><span class="badge warning">{{ t.high_risk }}</span></div>
</div>
{% endif %}

<!-- Admin roles -->
{% if admin_roles and admin_roles.global_admin_count > 4 %}
<div class="finding warning" id="finding-ga">
  <div class="finding-icon">&#x1F511;</div>
  <div class="finding-body">
    <h4>{{ t('ga_accounts_title', count=admin_roles.global_admin_count) }}</h4>
    <p>{{ t.ga_accounts_desc }}</p>
    {% if admin_roles.global_admin_users %}
    <div class="mfa-toggle" onclick="this.classList.toggle('open');this.nextElementSibling.classList.toggle('open')">
      <span class="arrow">&#x25B6;</span> {{ t('show_n_global_admins', count=admin_roles.global_admin_users|length) }}
    </div>
    <div class="mfa-drilldown">
      <table>
        <thead><tr><th>{{ t.user }}</th><th>{{ t.email_upn }}</th></tr></thead>
        <tbody>
        {% for u in admin_roles.global_admin_users %}
          <tr><td><strong>{{ u.user }}</strong></td><td style="font-size:12px;color:var(--muted);">{{ u.email }}</td></tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
