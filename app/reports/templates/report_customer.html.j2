<!-- ── Network Security (FortiGate + UniFi) ── -->
{% if network and network.has_data %}
<div class="section-label" style="margin-top:56px;" id="nettverk">{{ t.section_network }}</div>
<h2><a href="#nettverk" class="section-anchor">{{ t.section_network }}</a></h2>

{% if network.fortigate and 'error' not in network.fortigate %}
{% set fg = network.fortigate %}
<h3 style="margin-top:24px;">{{ t.section_fortigate }}</h3>
<div class="metrics">
  <div class="metric-card">
    <div class="num brand">{{ fg.model or fg.hostname or '–' }}</div>
    <div class="lbl">Modell</div>
  </div>
  <div class="metric-card">
    <div class="num brand">{{ fg.firmware or '–' }}</div>
    <div class="lbl">Firmware</div>
  </div>
  <div class="metric-card">
    <div class="num brand">{{ fg.policy_count | default(0) }}</div>
    <div class="lbl">Brannmurregler</div>
  </div>
  <div class="metric-card">
    <div class="num brand">{{ fg.admin_count | default(0) }}</div>
    <div class="lbl">Admins</div>
  </div>
  <div class="metric-card">
    <div class="num brand">{{ fg.vpn_tunnels | default(0) }}</div>
    <div class="lbl">VPN-tunneler</div>
  </div>
