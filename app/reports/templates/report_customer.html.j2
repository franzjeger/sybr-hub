        <div style="font-size:12px;color:var(--muted);margin-top:2px;">{{ rec.detail | replace('\n', '<br>') }}{% if rec.doc_url is defined and rec.doc_url %} <a href="{{ rec.doc_url }}" target="_blank" rel="noopener" style="font-size:11px;color:var(--blue);white-space:nowrap;">Microsoft Learn &rarr;</a>{% endif %}</div>
