      <span>{% if label.active %}<span style="color:var(--green);font-size:11px;">{{ t.active_label }}</span>{% else %}<span style="color:var(--muted);font-size:11px;">{{ t.inactive_label }}</span>{% endif %}</span>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if purview.dlp_policies %}
  <div class="env-card">
    <h4>{{ t.dlp_policies }}</h4>
    {% for pol in purview.dlp_policies %}
    <div class="env-row"><span>{{ pol.name }}</span><span></span></div>
    {% endfor %}
  </div>
  {% endif %}

  {% if purview.retention_policies %}
  <div class="env-card">
    <h4>{{ t.retention_policies }}</h4>
    {% for pol in purview.retention_policies %}
    <div class="env-row"><span>{{ pol.name }}</span><span></span></div>
    {% endfor %}
  </div>
  {% endif %}
</div>
{% endif %}


