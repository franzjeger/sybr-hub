<!DOCTYPE html>
<html data-theme="{{ theme }}" lang="{{ lang }}">
<head>
<meta charset="UTF-8">
<title>{{ t.report_title_customer }} — {{ customer_name }}</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; -webkit-user-drag: none; }
:root {
  --brand:  #1a3148;
  --brand2: #1d6387;
  --accent: #4d9fb5;
  --green:  #15803d; --green-bg: #f0fdf4; --green-bd: #bbf7d0;
  --orange: #c2410c; --orange-bg:#fff7ed; --orange-bd:#fed7aa;
  --red:    #b91c1c; --red-bg:  #fef2f2; --red-bd:   #fecaca;
  --blue-bg: #dbeafe; --blue-text: #1e40af;
  --text:   #111827; --muted: #6b7280; --border: #e5e7eb; --bg: #f9fafb;
  --font:   'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
}
[data-theme="dark"] {
  --brand: #8ec8e8; --brand2: #5ba3c9; --accent: #4d9fb5;
  --green: #4ade80; --green-bg: #14532d; --green-bd: #166534;
  --orange: #fb923c; --orange-bg: #431407; --orange-bd: #7c2d12;
  --red: #f87171; --red-bg: #450a0a; --red-bd: #7f1d1d;
  --blue-bg: #1e3a5f; --blue-text: #93c5fd;
  --text: #e5e7eb; --muted: #9ca3af; --border: #374151; --bg: #111827;
}
[data-theme="dark"] body { background: #0d1117; color: #e5e7eb; }
[data-theme="dark"] h2 { color: #8ec8e8; }
[data-theme="dark"] .toc { background: #161b22; }
[data-theme="dark"] .section-label { color: #4d9fb5; }
body { font-family: var(--font); color: var(--text); background: white; font-size: 14px; line-height: 1.6; }

/* Cover page */
.cover {
  display: block; padding: 60px;
  background: linear-gradient(160deg, #1d6387 0%, #236e8e 40%, #1a3148 100%);
  page-break-after: always; color: white;
}
@media screen {
  .cover { min-height: 100vh; display: flex; flex-direction: column; position: relative; overflow: hidden; }
  .cover::after {
    content: ''; position: absolute; right: -100px; top: -100px;
    width: 500px; height: 500px; border-radius: 50%;
    background: rgba(255,255,255,0.04);
  }
}
.cover-header { padding: 40px 60px; display: flex; justify-content: space-between; align-items: center; }
.cover-logo { color: white; font-size: 20px; font-weight: 700; letter-spacing: -0.5px; }
.cover-body { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 60px; }
.cover-label { color: #4d9fb5; font-size: 12px; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 20px; }
.cover-customer { font-size: 52px; font-weight: 800; color: white; line-height: 1.1; margin-bottom: 12px; border-bottom: 3px solid #4d9fb5; display: inline-block; padding-bottom: 8px; }
.cover-title { font-size: 22px; color: rgba(255,255,255,0.75); margin-bottom: 48px; }
.cover-divider { border: none; border-top: 1px solid rgba(255,255,255,0.2); margin-bottom: 40px; }
.cover-meta { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
.cover-meta-item label { color: #4d9fb5; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 4px; }
.cover-meta-item span { color: white; font-size: 15px; font-weight: 600; }
.cover-footer { padding: 32px 60px; border-top: 1px solid rgba(255,255,255,0.15); }
.cover-footer p { color: rgba(255,255,255,0.5); font-size: 11px; }

/* Layout */
.page { max-width: 860px; margin: 0 auto; padding: 56px 40px; }

/* TOC */
.toc { background: var(--bg); border: 1px solid var(--border); border-left: 4px solid #4d9fb5; border-radius: 12px; padding: 28px 32px; margin-bottom: 40px; }
.toc h3 { font-size: 13px; text-transform: uppercase; letter-spacing: 1.5px; color: var(--brand); font-weight: 700; margin-bottom: 16px; }
.toc ol { padding-left: 22px; }
.toc li { margin-bottom: 6px; font-size: 14px; }
.toc a { text-decoration: none; color: #1d6387; }
.toc a:hover { text-decoration: underline; }

/* Section headings */
.section-label { font-size: 11px; text-transform: uppercase; letter-spacing: 2px; color: #4d9fb5; font-weight: 700; margin-bottom: 8px; margin-top: 56px; }
h2 { font-size: 26px; font-weight: 800; color: #1a3148; margin-bottom: 8px; }
.section-intro { color: var(--muted); font-size: 14px; margin-bottom: 32px; max-width: 680px; }

/* Posture card */
.posture-card {
  background: linear-gradient(135deg, #1a3148 0%, #1d6387 100%);
  border-radius: 16px; padding: 36px 40px; color: white; margin-bottom: 32px;
  display: flex; align-items: center; gap: 40px;
}
.posture-grade {
  width: 96px; height: 96px; background: rgba(255,255,255,0.15); border-radius: 16px;
  display: flex; align-items: center; justify-content: center;
  font-size: 56px; font-weight: 900; flex-shrink: 0;
}
.posture-info h3 { font-size: 22px; font-weight: 700; margin-bottom: 4px; }
.posture-info p { color: rgba(255,255,255,0.7); font-size: 14px; max-width: 480px; }
.posture-score { margin-left: auto; text-align: center; flex-shrink: 0; }
.posture-score .num { font-size: 42px; font-weight: 800; line-height: 1; }
.posture-score .lbl { font-size: 11px; opacity: 0.6; text-transform: uppercase; letter-spacing: 1px; }

/* Metric grid */
.metrics { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 16px; }
.metric-card {
  background: white; border: 1px solid var(--border); border-radius: 12px;
  padding: 24px 20px; text-align: center;
}
.metric-card .icon { font-size: 24px; margin-bottom: 12px; }
.metric-card .num { font-size: 36px; font-weight: 800; line-height: 1; margin-bottom: 4px; }
.metric-card .lbl { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; }
.metric-card .sublbl { font-size: 12px; color: var(--muted); margin-top: 6px; }
.metric-card-invalid { background: #f9fafb; border-style: dashed; border-color: #d1d5db; }
.posture-card-invalid { background: #f9fafb; border-style: dashed; border-color: #d1d5db; }
.num.green  { color: var(--green); }
.num.orange { color: var(--orange); }
.num.red    { color: var(--red); }
.num.brand  { color: #1d6387; }

/* Progress bar */
.pbar { height: 6px; background: var(--border); border-radius: 3px; margin-top: 10px; }
.pbar-fill { height: 100%; border-radius: 3px; }
.pbar-fill.green  { background: var(--green); }
.pbar-fill.orange { background: var(--orange); }
.pbar-fill.red    { background: var(--red); }

/* Findings */
.finding {
  border-radius: 12px; padding: 20px 24px; margin-bottom: 14px;
  display: flex; align-items: flex-start; gap: 16px;
}
.finding.critical { background: var(--red-bg); border: 1px solid var(--red-bd); }
.finding.warning  { background: var(--orange-bg); border: 1px solid var(--orange-bd); }
.finding.ok       { background: var(--green-bg); border: 1px solid var(--green-bd); }
.finding-icon { font-size: 22px; flex-shrink: 0; margin-top: 2px; }
.finding-body h4 { font-size: 15px; font-weight: 700; margin-bottom: 4px; }
.finding.critical h4 { color: var(--red); }
.finding.warning  h4 { color: var(--orange); }
.finding.ok       h4 { color: var(--green); }
.finding-body p { font-size: 13px; color: var(--muted); }
.finding-badge { margin-left: auto; flex-shrink: 0; }
.badge { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap; }
.badge.critical { background: var(--red-bd); color: var(--red); }
.badge.warning  { background: var(--orange-bd); color: var(--orange); }
.badge.ok       { background: var(--green-bd); color: var(--green); }
.badge.medium   { background: #e0f4f4; color: #1d6387; }

/* Recommendations */
.rec {
  background: white; border: 1px solid var(--border); border-radius: 12px;
  padding: 20px 24px; margin-bottom: 12px; display: flex; align-items: flex-start; gap: 16px;
}
.rec-num {
  width: 32px; height: 32px; background: #1d6387; color: white;
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-size: 13px; font-weight: 700; flex-shrink: 0;
}
.rec-body h4 { font-size: 14px; font-weight: 700; margin-bottom: 4px; }
.rec-body p  { font-size: 13px; color: var(--muted); }
.rec-effort { margin-left: auto; flex-shrink: 0; text-align: right; }
.rec-effort .eff { font-size: 11px; color: var(--muted); }
.rec-expand {
  margin-top: 8px; cursor: pointer; font-size: 12px; color: var(--brand);
  font-weight: 600; user-select: none; display: flex; align-items: center; gap: 4px;
}
.rec-expand:hover { text-decoration: underline; }
.rec-expand .arrow { transition: transform 0.2s; font-size: 10px; }
.rec-expand.open .arrow { transform: rotate(90deg); }
.rec-sub-items {
  display: none; margin-top: 8px; padding: 10px 14px; background: var(--bg);
  border: 1px solid var(--border); border-radius: 8px; font-size: 12px;
  max-height: 300px; overflow-y: auto;
}
.rec-sub-items.open { display: block; }
.rec-sub-item { padding: 4px 0; border-bottom: 1px solid var(--border); color: var(--muted); }
.rec-sub-item:last-child { border-bottom: none; }

/* Finding ↔ Recommendation cross-links */
.finding-rec-link {
  display: inline-block; margin-top: 8px; font-size: 12px; font-weight: 600;
  color: #1d6387; text-decoration: none; cursor: pointer;
}
.finding-rec-link:hover { text-decoration: underline; }
.rec-finding-link {
  display: inline-block; margin-top: 6px; font-size: 11px; font-weight: 600;
  color: var(--muted); text-decoration: none;
}
.rec-finding-link:hover { color: #1d6387; text-decoration: underline; }

/* Clickable section headers */
h2 a.section-anchor {
  color: inherit; text-decoration: none;
}
h2 a.section-anchor:hover { color: #1d6387; }
h2 a.section-anchor::after {
  content: ' §'; font-size: 16px; color: transparent; transition: color 0.2s;
}
h2:hover a.section-anchor::after { color: #ccc; }

/* MFA drill-down table */
.mfa-drilldown {
  display: none; margin-top: 12px; background: white; border: 1px solid var(--border);
  border-radius: 8px; overflow: hidden;
}
.mfa-drilldown.open { display: block; }
.mfa-drilldown table { width: 100%; border-collapse: collapse; font-size: 12px; }
.mfa-drilldown th {
  text-align: left; padding: 8px 12px; background: var(--bg); font-size: 11px;
  font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.3px;
  border-bottom: 1px solid var(--border);
}
.mfa-drilldown td { padding: 6px 12px; border-bottom: 1px solid var(--border); }
.mfa-drilldown tr:last-child td { border-bottom: none; }
.mfa-drilldown .tag {
  display: inline-block; padding: 1px 8px; border-radius: 10px; font-size: 10px; font-weight: 600;
}
.mfa-drilldown .tag-no  { background: var(--red-bg); color: var(--red); border: 1px solid var(--red-bd); }
.mfa-drilldown .tag-yes { background: var(--green-bg); color: var(--green); border: 1px solid var(--green-bd); }
.mfa-toggle {
  margin-top: 10px; cursor: pointer; font-size: 12px; color: var(--brand2);
  font-weight: 600; user-select: none; display: inline-flex; align-items: center; gap: 4px;
}
.mfa-toggle:hover { text-decoration: underline; }
.mfa-toggle .arrow { transition: transform 0.2s; font-size: 10px; }
.mfa-toggle.open .arrow { transform: rotate(90deg); }

/* Env overview */
.env-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 32px; }
.env-card { background: white; border: 1px solid var(--border); border-radius: 12px; padding: 20px 24px; margin-bottom: 16px; }
.env-card h4 { font-size: 13px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 12px; }
.env-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; border-bottom: 1px solid var(--border); font-size: 13px; }
.env-row:last-child { border-bottom: none; }
.env-row span:last-child { font-weight: 600; }

/* Tables */
.email-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.email-table th { text-align: left; padding: 8px 12px; color: var(--muted); font-size: 11px; text-transform: uppercase; letter-spacing: 0.4px; border-bottom: 2px solid var(--border); }
.email-table td { padding: 10px 12px; border-bottom: 1px solid var(--border); }
.email-table tr:last-child td { border-bottom: none; }
.status-pill { display: inline-block; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-weight: 700; }
.status-pill.ok       { background: var(--green-bg); color: var(--green); }
.status-pill.warning  { background: var(--orange-bg); color: var(--orange); }
.status-pill.critical { background: var(--red-bg); color: var(--red); }
/* Neither compliant nor a finding — the setting was not read. */
.status-pill.unknown  { background: #e5e7eb; color: #4b5563; }

/* Alert inline */
.alert-inline {
  background: var(--orange-bg); border: 1px solid var(--orange-bd); border-radius: 8px;
  padding: 12px 16px; margin-top: 12px; font-size: 12px; color: var(--orange);
}

/* Footer */
.report-footer {
  background: #1a3148; color: white; padding: 40px 60px;
  margin-top: 80px; display: flex; justify-content: space-between; align-items: center;
}
.report-footer .msp { font-size: 16px; font-weight: 700; }
.report-footer .meta { font-size: 12px; opacity: 0.6; text-align: right; }

/* Trend indicators */
.trend-row { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 24px; }
.trend-item { font-size: 12px; padding: 6px 12px; background: var(--bg); border: 1px solid var(--border); border-radius: 8px; }
.trend-up { color: var(--green); }
.trend-down { color: var(--red); }
.trend-arrow { font-weight: 700; }

/* Trend charts */
.trend-charts { display: flex; flex-wrap: wrap; gap: 16px; margin-bottom: 28px; }
.trend-chart-card {
  flex: 1 1 200px; max-width: 240px; background: var(--bg); border: 1px solid var(--border);
  border-radius: 10px; padding: 10px 12px 8px; text-align: center;
}
.trend-chart-card .chart-title { font-size: 11px; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.3px; margin-bottom: 6px; }
.trend-chart-card svg { display: block; margin: 0 auto; }

/* Action plan */
.action-table { width: 100%; border-collapse: collapse; font-size: 13px; margin-top: 16px; }
.action-table th {
  text-align: left; padding: 10px 14px; color: var(--muted); font-size: 11px;
  text-transform: uppercase; letter-spacing: 0.4px; border-bottom: 2px solid var(--border);
  background: var(--bg);
}
.action-table td { padding: 12px 14px; border-bottom: 1px solid var(--border); vertical-align: top; }
.action-table tr:last-child td { border-bottom: none; }
.action-table .placeholder { color: #ccc; font-style: italic; }

/* PDF / Print — prevent ALL content overflow on A4
   A4 = 210mm wide, margins 18mm each side = 174mm printable = ~657px.
   WeasyPrint is always in "print" mode — no @media print needed for it. */
*, *::before, *::after { overflow-wrap: break-word; word-wrap: break-word; box-sizing: border-box; }
html, body { max-width: 100%; overflow-x: hidden; }
.page { max-width: 100%; padding: 0; overflow: hidden; }
table { table-layout: fixed; width: 100%; border-collapse: collapse; }
td, th { overflow-wrap: break-word; word-break: break-word; overflow: hidden; }
img, svg { max-width: 100%; height: auto; }
.posture-card { max-width: 100%; overflow: hidden; }
.metrics { grid-template-columns: repeat(3, 1fr); max-width: 100%; }
.env-grid { grid-template-columns: 1fr 1fr; max-width: 100%; }
.env-card { overflow: hidden; }
.finding { overflow: hidden; max-width: 100%; }
.rec { overflow: hidden; max-width: 100%; }
.rec-sub-items { max-width: 100%; overflow: hidden; }
.cover-meta { grid-template-columns: repeat(3, 1fr); max-width: 100%; }
.action-table td, .action-table th { overflow: hidden; text-overflow: ellipsis; }
.action-table col.col-status { width: 12%; }
.action-table col.col-action { width: 50%; }
.action-table col.col-priority { width: 15%; }
.action-table col.col-effort { width: 12%; }
.action-table col.col-responsible { width: 11%; }
.mfa-drilldown { max-width: 100%; overflow: hidden; }
.mfa-drilldown table { table-layout: fixed; }
.mfa-drilldown td { overflow-wrap: break-word; }
.email-table { table-layout: fixed; }
.email-table td { overflow: hidden; text-overflow: ellipsis; }
.trend-row { max-width: 100%; overflow: hidden; }
div[style*="display:flex"] { max-width: 100%; overflow: hidden; }
div[style*="display:grid"] { max-width: 100%; overflow: hidden; }
pre, code { white-space: pre-wrap; word-break: break-all; max-width: 100%; }

@media print {
  .cover { height: 297mm; min-height: 0; page-break-after: always; }
  .toc { page-break-after: always; }
  h2 { page-break-after: avoid; }
  .posture-card, .metrics { page-break-inside: avoid; }
  .env-grid { page-break-inside: auto; }
  .env-card { page-break-inside: avoid; }
  .finding { page-break-inside: avoid; }
  .rec { page-break-inside: avoid; }
  table { page-break-inside: auto; }
  tr { page-break-inside: avoid; }
  .action-table { page-break-inside: auto; }
  .action-table tr { page-break-inside: avoid; }
  .rec-expand { display: none; }
  .rec-sub-items { display: block !important; max-height: none; }
  .mfa-toggle { display: none; }
  .mfa-drilldown { display: block !important; }
}

@page {
  size: A4;
  margin: 20mm 18mm 22mm 18mm;
  {% if theme == "dark" %}background: #0d1117;{% endif %}
  @bottom-center {
    content: "{{ t.page_of }} " counter(page) " {{ t.of }} " counter(pages);
    font-size: 8px; color: {% if theme == "dark" %}#6b7280{% else %}#9ca3af{% endif %}; font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
  }
  @bottom-left {
    content: "{{ t('page_footer_left', company=(branding.company_name if branding is defined and branding.company_name else 'SYBR AS')) }}";
    font-size: 7px; color: {% if theme == "dark" %}#4b5563{% else %}#d1d5db{% endif %}; font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
  }
  @bottom-right {
    content: "{{ t.confidential }}";
    font-size: 7px; color: {% if theme == "dark" %}#4b5563{% else %}#d1d5db{% endif %}; font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
  }
}

@page :first {
  margin: 0;
  {% if theme == "dark" %}background: #0d1117;{% endif %}
  @bottom-center { content: none; }
  @bottom-left { content: none; }
  @bottom-right { content: none; }
}
</style>
</head>
<body>

<!-- ── Cover ── -->
<div class="cover">
  <div class="cover-header">
    <div class="cover-logo">
      {% if logo_light %}<img src="{{ logo_light }}" alt="SYBR" style="height:48px;opacity:0.9;">{% endif %}
    </div>
    <div style="color:rgba(255,255,255,0.5);font-size:12px;">{{ t.confidential }}</div>
  </div>
  <div class="cover-body">
    <div class="cover-label">{{ t.report_title_customer }} · {{ report_date_no }}</div>
    <div class="cover-customer">{{ customer_name }}</div>
    <div class="cover-title">{{ t.report_subtitle }}</div>
    <hr class="cover-divider">
    <div class="cover-meta">
      <div class="cover-meta-item"><label>{{ t.primary_domain }}</label><span>{{ org_domain }}</span></div>
      <div class="cover-meta-item"><label>{{ t.report_date }}</label><span>{{ report_date_no }}</span></div>
      <div class="cover-meta-item"><label>{{ t.prepared_by }}</label><span>{{ branding.company_name if branding is defined and branding.company_name else 'SYBR AS' }}</span></div>
    </div>
  </div>
  <div class="cover-footer">
    <p>{{ t('confidential_notice', customer=customer_name) }}</p>
  </div>
</div>

<div class="page">

<!-- ── Table of Contents ── -->
<div class="toc">
  <h3>{{ t.toc_title }}</h3>
  <ol>
    <li><a href="#sammendrag">{{ t.summary }}</a></li>
    <li><a href="#postur">{{ t.security_posture }}</a></li>
    <li><a href="#funn">{{ t.key_findings }}</a></li>
    <li><a href="#anbefalinger">{{ t.recommendations }}</a></li>
    <li><a href="#handlingsplan">{{ t.action_plan }}</a></li>
    <li><a href="#identitet">{{ t.identity_access }}</a></li>
    <li><a href="#enheter">{{ t.devices }}</a></li>
    <li><a href="#data">{{ t.data_collaboration }}</a></li>
    <li><a href="#exchange">{{ t.email_exchange }}</a></li>
    <li><a href="#apper">{{ t.apps_integrations }}</a></li>
    {% if purview and purview.has_data %}<li><a href="#databeskyttelse">{{ t.data_protection }}</a></li>{% endif %}
    <li><a href="#azure">{{ t.azure_infrastructure }}</a></li>
    {% if network and network.has_data %}<li><a href="#nettverk">{{ t.section_network }}</a></li>{% endif %}
    {% if baseline %}<li><a href="#standard">{{ t.baseline_label }}</a></li>{% endif %}
    {% if compliance %}<li><a href="#compliance">CIS {{ t.compliance }}</a></li>{% endif %}
    <li><a href="#miljo">{{ t.environment_overview }}</a></li>
  </ol>
</div>

<!-- ── Executive Summary ── -->
{% if executive_summary %}
<div class="section-label" style="margin-top:0;" id="sammendrag">{{ t.summary }}</div>
<h2 style="font-size:28px;"><a href="#sammendrag" class="section-anchor">{{ t.main_findings }}</a></h2>
<p class="section-intro">{{ t('executive_summary_intro', customer=customer_name) }}</p>

<div style="background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:24px 28px;">
  {% for bullet in executive_summary %}
