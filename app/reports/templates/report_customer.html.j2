<!-- ── Compliance ── -->
{# ── Sybr Standard ──────────────────────────────────────────────────────────
   Placed before the CIS section on purpose: what we require, then what the
   industry benchmark says. A customer who reads only the first block should
   have read the one they can be held to. #}
{% if baseline %}
<div class="section-label" style="margin-top:56px;" id="standard">{{ t.baseline_label }}</div>
<h2><a href="#standard" class="section-anchor">{{ baseline.baseline.name }} {{ baseline.baseline.version }}</a></h2>
<p class="section-intro">{{ t.baseline_intro }}</p>

<div class="metrics" style="margin-bottom:24px;">
  <div class="metric-card">
    {# No percentage when nothing could be assessed. 0 % would be a verdict,
       and the absence of a verdict is not one. #}
    <div class="num {% if baseline.conformance_pct is none %}{% elif baseline.conformance_pct >= 90 %}green{% elif baseline.conformance_pct >= 70 %}orange{% else %}red{% endif %}"
         {% if baseline.conformance_pct is none %}style="color:var(--text-dim);"{% endif %}>
      {% if baseline.conformance_pct is none %}&mdash;{% else %}{{ baseline.conformance_pct }} %{% endif %}
    </div>
    <div class="lbl">{{ t.baseline_conformance }}</div>
  </div>
  <div class="metric-card">
    <div class="num green">{{ baseline.passed }}</div>
    <div class="lbl">{{ t.baseline_met }}</div>
  </div>
  <div class="metric-card">
    <div class="num red">{{ baseline.failed }}</div>
    <div class="lbl">{{ t.baseline_deviation }}</div>
  </div>
  <div class="metric-card">
    <div class="num" style="color:var(--text-dim);">{{ baseline.not_measured }}</div>
    <div class="lbl">{{ t.not_assessed }}</div>
  </div>
</div>

{% if baseline.assessed == 0 %}
<p class="section-intro" style="margin-top:-12px;">{{ t.baseline_nothing_assessed }}</p>
{% elif baseline.not_measured %}
<p class="section-intro" style="margin-top:-12px;">{{ t('baseline_basis', assessed=baseline.assessed, total=baseline.total_checks, skipped=baseline.not_measured) }}</p>
{% endif %}

<div class="env-card">
  <table class="email-table">
    <tr><th>{{ t.baseline_requirement }}</th><th>{{ t.status }}</th><th>{{ t.details }}</th></tr>
    {% for c in baseline.checks %}
    <tr>
      <td>
        {{ c.title }}
        {# The rationale earns its place where there is something to fix. #}
        {% if c.status == 'fail' and c.why %}
        <div style="font-size:11px;color:var(--muted);margin-top:4px;line-height:1.5;">{{ c.why }}</div>
        {% endif %}
      </td>
      <td>
        {% if c.status == 'pass' %}<span class="status-pill ok">{{ t.baseline_met }}</span>
        {% elif c.status == 'fail' %}<span class="status-pill {% if c.severity == 'critical' %}critical{% else %}warning{% endif %}">{{ t.baseline_deviation }}</span>
        {% else %}<span class="status-pill" style="background:#dbeafe;color:#1e40af;">{{ t.not_assessed }}</span>{% endif %}
      </td>
      <td style="font-size:11px;color:var(--muted);">{{ c.detail }}</td>
    </tr>
    {% endfor %}
  </table>
</div>

{# ── Policy drift ──────────────────────────────────────────────────────── #}
{% if drift %}
<h3 style="margin-top:32px;">{{ t.drift_heading }}</h3>
<p class="section-intro">{{ t.drift_intro }}</p>
{% if not drift.measured %}
<div class="env-card">
  <p style="margin:0;font-size:13px;color:var(--muted);">
    <strong>{{ t.drift_not_measured }}.</strong> {{ drift.reason }}
  </p>
</div>
{% elif drift.added_total == 0 and drift.removed_total == 0 and drift.changed_total == 0 %}
<div class="env-card">
  <p style="margin:0;font-size:13px;color:var(--muted);">{{ t('drift_quiet', run=drift.compared_with) }}</p>
</div>
{% else %}
<p class="section-intro" style="margin-top:-12px;">{{ t('drift_summary', run=drift.compared_with, added=drift.added_total, removed=drift.removed_total, changed=drift.changed_total) }}</p>
<div class="env-card">
  <table class="email-table">
    <tr><th>{{ t.status }}</th><th>{{ t.drift_policy }}</th><th>{{ t.drift_fields }}</th></tr>
    {% for s in drift.snapshots %}{% if s.comparable %}
      {% for p in s.removed %}
      <tr><td><span class="status-pill critical">{{ t.drift_removed }}</span></td><td>{{ p.name or t.drift_unnamed }}</td><td style="font-size:11px;color:var(--muted);">&mdash;</td></tr>
      {% endfor %}
      {% for p in s.changed %}
      <tr><td><span class="status-pill warning">{{ t.drift_changed }}</span></td><td>{{ p.name or t.drift_unnamed }}</td><td style="font-size:11px;color:var(--muted);">{{ p.fields | join(', ') }}</td></tr>
      {% endfor %}
      {% for p in s.added %}
      <tr><td><span class="status-pill ok">{{ t.drift_added }}</span></td><td>{{ p.name or t.drift_unnamed }}</td><td style="font-size:11px;color:var(--muted);">&mdash;</td></tr>
      {% endfor %}
    {% endif %}{% endfor %}
  </table>
</div>
{% endif %}
{% endif %}
{% endif %}

{% if compliance %}
<div class="section-label" style="margin-top:56px;" id="compliance">{{ t.compliance }}</div>
<h2><a href="#compliance" class="section-anchor">{{ t.cis_benchmark }}</a></h2>
<p class="section-intro">{{ t.compliance_intro }}</p>

<div class="metrics" style="margin-bottom:24px;">
  <div class="metric-card">
    <div class="num green">{{ compliance_pass }}</div>
    <div class="lbl">{{ t.passed }}</div>
  </div>
  <div class="metric-card">
    <div class="num orange">{{ compliance_partial }}</div>
    <div class="lbl">{{ t.partial_warning }}</div>
  </div>
  <div class="metric-card">
    <div class="num red">{{ compliance_fail }}</div>
    <div class="lbl">{{ t.not_passed }}</div>
  </div>
  {# Controls with no data behind them are excluded from the percentage's
     denominator. That is the right arithmetic, but showing the percentage
     without showing what it is a percentage of invites the reader to assume
     every control was measured. #}
  <div class="metric-card">
    <div class="num" style="color:var(--text-dim);">{{ compliance_info }}</div>
    <div class="lbl">{{ t.not_assessed }}</div>
  </div>
</div>
{% if compliance_info %}
<p class="section-intro" style="margin-top:-12px;">{{ t('compliance_basis', assessed=compliance_assessed, total=compliance_total, skipped=compliance_info) }}</p>
{% endif %}

<div class="env-card">
  <table class="email-table">
    <tr><th>{{ t.cis_id }}</th>{% if show_nist %}<th>NIST CSF</th>{% endif %}{% if show_iso %}<th>ISO 27001</th>{% endif %}<th>{{ t.control }}</th><th>{{ t.category }}</th><th>{{ t.status }}</th><th>{{ t.details }}</th></tr>
    {% for c in compliance %}
    <tr>
      <td style="font-family:monospace;font-weight:600;">{{ c.cis_id }}</td>
      {% if show_nist %}<td style="font-family:monospace;font-size:11px;color:var(--muted);">{{ c.nist_id | default('') }}</td>{% endif %}
      {% if show_iso %}<td style="font-family:monospace;font-size:11px;color:var(--muted);">{{ c.iso_id | default('') }}</td>{% endif %}
      <td>{{ c.title }}</td>
      <td style="font-size:11px;color:var(--muted);">{{ c.category }}</td>
      <td>
        {% if c.status == 'pass' %}<span class="status-pill ok">{{ t.passed }}</span>
        {% elif c.status == 'partial' %}<span class="status-pill warning">{{ t.partial }}</span>
        {% elif c.status == 'fail' %}<span class="status-pill critical">{{ t.failed }}</span>
        {% elif c.status == 'warn' %}<span class="status-pill warning">{{ t.warning }}</span>
        {% else %}<span class="status-pill" style="background:#dbeafe;color:#1e40af;">{{ t.info }}</span>{% endif %}
      </td>
      <td style="font-size:11px;color:var(--muted);">{{ c.detail }}</td>
    </tr>
    {% endfor %}
  </table>
</div>
{% endif %}

<!-- ══════════════════════════════════════════════════════════════════════ -->
<!-- ── 8. Environment Overview ── -->
<div class="section-label" style="margin-top:56px;" id="miljo">{{ t.environment_overview }}</div>
<h2><a href="#miljo" class="section-anchor">{{ t.your_m365_environment }}</a></h2>
<p class="section-intro">{{ t.env_overview_intro }}</p>

<div class="env-grid">
  <div class="env-card">
    <h4>{{ t.users_label }}</h4>
    {% if users.has_data %}
    <div class="env-row"><span>{{ t.total_user_count }}</span><span>{{ users.total }}</span></div>
    <div class="env-row"><span>{{ t.active_users }}</span><span>{{ users.enabled }}</span></div>
    <div class="env-row"><span>{{ t.disabled_users }}</span><span>{{ users.disabled }}</span></div>
    <div class="env-row"><span>{{ t.guest_users }}</span><span>{{ users.guests }}</span></div>
    <div class="env-row"><span>{{ t.hybrid_synced }}</span><span>{{ users.hybrid }}</span></div>
    {% else %}
    <div class="env-row"><span>{{ t.total_user_count }}</span><span style="color:#9ca3af;">{{ t.data_unavailable }}</span></div>
    <div class="env-row"><span>{{ t.active_users }}</span><span style="color:#9ca3af;">{{ t.data_unavailable }}</span></div>
    <div class="env-row"><span>{{ t.disabled_users }}</span><span style="color:#9ca3af;">{{ t.data_unavailable }}</span></div>
    <div class="env-row"><span>{{ t.guest_users }}</span><span style="color:#9ca3af;">{{ t.data_unavailable }}</span></div>
    <div class="env-row"><span>{{ t.hybrid_synced }}</span><span style="color:#9ca3af;">{{ t.data_unavailable }}</span></div>
    {% endif %}
  </div>

  <div class="env-card">
    <h4>{{ t.security_label }}</h4>
    {% if mfa.has_data %}
    <div class="env-row"><span>{{ t.mfa_coverage }}</span><span>{{ mfa.pct | round(0) | int }}%</span></div>
    <div class="env-row"><span>{{ t.users_without_mfa }}</span><span>{{ mfa.no_mfa }}</span></div>
    {% else %}
    <div class="env-row"><span>{{ t.mfa_coverage }}</span><span style="color:#9ca3af;">{{ t.data_unavailable }}</span></div>
    <div class="env-row"><span>{{ t.users_without_mfa }}</span><span style="color:#9ca3af;">{{ t.data_unavailable }}</span></div>
    {% endif %}
    <div class="env-row"><span>{{ t.ca_policies_label }}</span><span>{{ ca.enabled }}</span></div>
    <div class="env-row"><span>{{ t.microsoft_secure_score }}</span>{% if secure_score.has_data %}<span>{{ secure_score.pct | round(0) | int }}%</span>{% else %}<span style="color:#9ca3af;">{{ t.data_unavailable }}</span>{% endif %}</div>
  </div>
</div>

{% if spf_dmarc %}
<div class="env-card">
  <h4>{{ t.email_security_per_domain }}</h4>
  <table class="email-table">
    <tr>
      <th>{{ t.domain }}</th><th>SPF</th><th>DMARC</th><th>DKIM</th><th>MTA-STS</th>
    </tr>
    {% for d in spf_dmarc %}
    <tr>
      <td style="font-weight:600;">{{ d.get('domain','') }}</td>
      <td>
        {% set s = d.get('spf','') %}
        {% if 'MISSING' in s or 'CRITICAL' in s %}<span class="status-pill critical">{{ t.missing_label }}</span>
        {% elif 'WEAK' in s %}<span class="status-pill warning">{{ t.weak_label }}</span>
        {% else %}<span class="status-pill ok">{{ t.ok }}</span>{% endif %}
      </td>
      <td>
        {% set s = d.get('dmarc','') %}
        {% if 'MISSING' in s %}<span class="status-pill critical">{{ t.missing_label }}</span>
        {% elif 'WEAK' in s or 'none' in s %}<span class="status-pill warning">{{ t.weak_label }}</span>
        {% else %}<span class="status-pill ok">{{ t.ok }}</span>{% endif %}
      </td>
      <td>
        {% set d1 = d.get('dkim1','') %}{% set d2 = d.get('dkim2','') %}
        {% if 'MISSING' in d1 and 'MISSING' in d2 %}<span class="status-pill critical">{{ t.missing_label }}</span>
        {% else %}<span class="status-pill ok">{{ t.found_label }}</span>{% endif %}
      </td>
      <td>
        {% set s = d.get('mta_sts','') %}
        {% if 'MISSING' in s %}<span class="status-pill warning">{{ t.missing_label }}</span>
        {% else %}<span class="status-pill ok">{{ t.ok }}</span>{% endif %}
      </td>
    </tr>
    {% endfor %}
  </table>
</div>
{% endif %}

{% if licenses %}
<div class="env-card">
  <h4>{{ t.licences_label }}</h4>
  <table class="email-table">
    <tr><th>{{ t.product }}</th><th>{{ t.used }}</th><th>{{ t.purchased }}</th><th>{{ t.utilisation }}</th></tr>
    {% for lic in licenses %}
    <tr>
      <td>{{ lic.part }}</td>
      <td>{{ lic.used }}</td>
      <td>{{ lic.total }}</td>
      <td>
        <div class="pbar" style="width:120px;display:inline-block;vertical-align:middle;margin-right:8px;">
          <div class="pbar-fill {% if lic.pct >= 90 %}red{% elif lic.pct >= 75 %}orange{% else %}green{% endif %}" style="width:{{ [lic.pct,100]|min }}%"></div>
        </div>
        {{ lic.pct | round(0) | int }}%
        {% if lic.warn %}<span class="badge warning" style="margin-left:4px;">{{ t.near_limit }}</span>{% endif %}
      </td>
    </tr>
    {% endfor %}
  </table>
</div>
{% endif %}

{# ── License Optimization ────────────────────────────────────────────── #}
{% if license_optimization is defined and license_optimization %}
<div class="env-card" style="margin-top:16px;">
  <h4>{{ t.lo_title }}</h4>

  {% if not license_optimization.has_data %}
  <p style="color:#888;font-style:italic;">
    {%- if license_optimization.no_data_reason == 'not_collected' -%}
      {{ t.lo_not_collected }}
    {%- else -%}
      {{ t.lo_no_data }}
    {%- endif -%}
  </p>
  {% elif license_optimization.total_waste_estimate == 0 and not license_optimization.unused_licenses and not license_optimization.over_provisioned and not license_optimization.downgrade_candidates %}
  <p style="color:#27ae60;">{{ t.lo_no_issues }}</p>
  {% else %}

  {# Estimated monthly waste banner #}
  {% if license_optimization.total_waste_estimate > 0 %}
  <div style="background:#fff3e0;border-left:4px solid #f39c12;padding:12px 16px;margin-bottom:16px;border-radius:4px;">
    <strong>{{ t.lo_estimated_waste }}:</strong>
    <span style="font-size:1.3em;font-weight:700;color:#e67e22;margin-left:8px;">
      {{ "{:,}".format(license_optimization.total_waste_estimate).replace(",", " ") }} {{ t.lo_per_month }}
    </span>
  </div>
  {% endif %}

  {# Unused licenses (inactive users) #}
  {% if license_optimization.unused_licenses %}
  <h5 style="margin-top:16px;">{{ t.lo_unused_licenses }}</h5>
  <table class="email-table">
    <tr><th>{{ t.lo_user }}</th><th>UPN</th><th>{{ t.lo_inactive }}</th></tr>
    {% for u in license_optimization.unused_licenses[:15] %}
    <tr>
      <td>{{ u.name }}</td>
      <td style="font-size:0.9em;">{{ u.upn }}</td>
      <td>{{ u.days_label }}</td>
    </tr>
    {% endfor %}
    {% if license_optimization.unused_licenses | length > 15 %}
    <tr><td colspan="3" style="text-align:center;color:#888;font-style:italic;">
      ... +{{ license_optimization.unused_licenses | length - 15 }} {{ t.lo_days }}
    </td></tr>
    {% endif %}
  </table>
  {% endif %}

  {# Over-provisioned SKUs #}
  {% if license_optimization.over_provisioned %}
  <h5 style="margin-top:16px;">{{ t.lo_over_provisioned }}</h5>
  <table class="email-table">
    <tr><th>{{ t.lo_sku }}</th><th>{{ t.lo_assigned }}</th><th>{{ t.purchased }}</th><th>{{ t.lo_unused_count }}</th><th>{{ t.lo_waste }}</th></tr>
    {% for op in license_optimization.over_provisioned %}
    <tr>
      <td>{{ op.part }}</td>
      <td>{{ op.used }}</td>
      <td>{{ op.total }}</td>
      <td><span style="color:#e67e22;font-weight:600;">{{ op.unused }}</span></td>
      <td>{% if op.monthly_waste > 0 %}{{ "{:,}".format(op.monthly_waste).replace(",", " ") }} {{ t.lo_per_month }}{% else %}&mdash;{% endif %}</td>
    </tr>
    {% endfor %}
  </table>
  {% endif %}

  {# Optimization suggestions #}
  {% if license_optimization.optimization_suggestions %}
  <h5 style="margin-top:16px;">{{ t.lo_suggestions }}</h5>
  {% for s in license_optimization.optimization_suggestions %}
  <div style="background:#f8f9fa;border-radius:6px;padding:10px 14px;margin-bottom:8px;border-left:4px solid {% if s.priority == 'high' %}#e74c3c{% elif s.priority == 'medium' %}#f39c12{% else %}#3498db{% endif %};">
    <strong>{{ s.title }}</strong>
    {% if s.priority == 'high' %}<span class="badge danger" style="margin-left:6px;">{{ t.lo_priority_high }}</span>
    {% elif s.priority == 'medium' %}<span class="badge warning" style="margin-left:6px;">{{ t.lo_priority_medium }}</span>
    {% else %}<span class="badge info" style="margin-left:6px;">{{ t.lo_priority_low }}</span>{% endif %}
    <div style="margin-top:4px;font-size:0.92em;color:#555;">{{ s.detail }}</div>
  </div>
  {% endfor %}
  {% endif %}

  <p style="font-size:0.85em;color:#999;margin-top:12px;font-style:italic;">{{ t.lo_note_estimates }}</p>
  {% endif %}
</div>
{% endif %}

</div><!-- /page -->

<div class="report-footer">
  <div style="display:flex;align-items:center;gap:12px;">
    {% if logo_dark %}<img src="{{ logo_dark }}" alt="SYBR" style="height:28px;">{% endif %}
    <div>
      <div class="msp">{{ branding.company_name if branding is defined and branding.company_name else 'SYBR AS' }}</div>
      <div style="font-size:12px;opacity:0.6;margin-top:2px;">{{ t.report_title_customer }}</div>
    </div>
  </div>
  <div class="meta">
    <div>{{ customer_name }}</div>
    <div>{{ report_date_no }}</div>
    <div style="margin-top:4px;">{{ t.confidential }}</div>
    <div style="margin-top:2px;font-size:10px;opacity:0.4;">{{ app_version }}</div>
  </div>
</div>

<script>
// Fix anchor navigation when loaded inside an iframe
document.addEventListener('click', function(e) {
  var a = e.target.closest('a[href^="#"]');
  if (!a) return;
  e.preventDefault();
  var id = a.getAttribute('href').substring(1);
  var el = document.getElementById(id);
  if (el) el.scrollIntoView({behavior: 'smooth'});
});
</script>
</body>
</html>
