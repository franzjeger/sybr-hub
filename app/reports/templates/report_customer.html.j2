<!-- ── 1. Security Posture ── -->
<div class="section-label" id="postur">{{ t.security_posture }}</div>
<h2><a href="#postur" class="section-anchor">{{ t.your_security_status }}</a></h2>
<p class="section-intro">
  {{ t.posture_intro }}
</p>

<div class="posture-card{% if risk.grade == '?' %} posture-card-invalid{% endif %}">
  <div class="posture-grade">{{ risk.grade }}</div>
  <div class="posture-info">
    <h3>{{ risk.level }}</h3>
    <p>
      {% if risk.grade == '?' %}
      {{ t.posture_grade_invalid }}
      {% elif risk.grade == 'A' %}
      {{ t.posture_grade_a }}
      {% elif risk.grade == 'B' %}
      {{ t.posture_grade_b }}
      {% elif risk.grade == 'C' %}
      {{ t.posture_grade_c }}
      {% else %}
      {{ t.posture_grade_d }}
      {% endif %}
      {% if risk.blocking_data_gaps %}
      <br><strong>{{ t.posture_blocking_gaps_label }}</strong>
      <ul>
        {% for gap in risk.blocking_data_gaps %}<li>{{ gap }}</li>{% endfor %}
      </ul>
      {% endif %}
    </p>
  </div>
  <div class="posture-score">
    <div class="num">{% if risk.score is none %}—{% else %}{{ risk.score }}{% endif %}</div>
    <div class="lbl">{{ t.of_100_points }}</div>
  </div>
</div>

{% if trends %}
{% set trend_labels = {
  "mfa_coverage_pct": t.trend_mfa_coverage,
  "secure_score_pct": t.trend_secure_score,
  "total_users": t.trend_users,
  "users_no_mfa": t.trend_without_mfa,
  "ca_policies_enabled": t.trend_ca_policies,
  "intune_compliance_pct": t.trend_device_compliance,
  "intune_total_devices": t.trend_devices,
  "admin_roles_ga_count": t.trend_global_admins,
  "total_warns": t.trend_warnings,
  "risk_score": t.trend_risk_score
} %}
{% set trend_suffix = {
  "mfa_coverage_pct": "%",
  "secure_score_pct": "%",
  "intune_compliance_pct": "%"
} %}
<div class="trend-row">
  {% for key, tr in trends.items() %}
  <div class="trend-item">
    <span>{{ trend_labels.get(key, key) }}: </span>
    <span>{{ tr.previous }}{{ trend_suffix.get(key, '') }}</span>
    <span class="trend-arrow {% if tr.improved %}trend-up{% else %}trend-down{% endif %}">
      {% if tr.improved %}&uarr;{% else %}&darr;{% endif %}
    </span>
    <span>{{ tr.current }}{{ trend_suffix.get(key, '') }}</span>
    <span class="{% if tr.improved %}trend-up{% else %}trend-down{% endif %}">
      ({% if tr.delta > 0 %}+{% endif %}{{ tr.delta }}{{ trend_suffix.get(key, '') }})
    </span>
  </div>
  {% endfor %}
</div>

{# ── Trend charts (SVG) ─────────────────────────────────────────── #}
{% if metrics_timeline|length >= 2 %}
{% set tl = metrics_timeline %}
{% set n = tl|length %}
{# Chart dimensions #}
{% set cw = 200 %}
{% set ch = 80 %}
{% set pad_x = 28 %}
{% set pad_y = 16 %}
{% set plot_w = cw - 2 * pad_x %}
{% set plot_h = ch - 2 * pad_y %}

{# ── Macro: line chart for percentage / score metrics ─────────── #}
{% macro line_chart(metric_key, title, suffix, max_val_override=None) %}
  {% set values = [] %}
  {% for pt in tl %}
    {% if pt[metric_key] is defined and pt[metric_key] is not none %}
      {% set _ = values.append(pt[metric_key]) %}
    {% endif %}
  {% endfor %}
  {% if values|length >= 2 %}
  {% set v_min = values|min %}
  {% set v_max = values|max %}
  {# Use override max if provided (e.g. 100 for percentages) #}
  {% if max_val_override is not none and max_val_override > v_max %}
    {% set v_max = max_val_override %}
  {% endif %}
  {# Ensure range is not zero #}
  {% set v_range = v_max - v_min if v_max != v_min else 1 %}
  {% set step_x = plot_w / (values|length - 1) if values|length > 1 else 0 %}
  <div class="trend-chart-card">
    <div class="chart-title">{{ title }}</div>
    <svg xmlns="http://www.w3.org/2000/svg" width="{{ cw }}" height="{{ ch }}" viewBox="0 0 {{ cw }} {{ ch }}">
      {# Grid lines #}
      <line x1="{{ pad_x }}" y1="{{ pad_y }}" x2="{{ pad_x + plot_w }}" y2="{{ pad_y }}" stroke="#e2e8f0" stroke-width="0.5"/>
      <line x1="{{ pad_x }}" y1="{{ pad_y + plot_h }}" x2="{{ pad_x + plot_w }}" y2="{{ pad_y + plot_h }}" stroke="#e2e8f0" stroke-width="0.5"/>
      <line x1="{{ pad_x }}" y1="{{ pad_y + plot_h / 2 }}" x2="{{ pad_x + plot_w }}" y2="{{ pad_y + plot_h / 2 }}" stroke="#e2e8f0" stroke-width="0.5" stroke-dasharray="3,3"/>
      {# Area fill #}
      {% set points_line = [] %}
      {% set points_area = [] %}
      {% for v in values %}
        {% set px = pad_x + step_x * loop.index0 %}
        {% set py = pad_y + plot_h - (plot_h * ((v - v_min) / v_range)) %}
        {% set _ = points_line.append("%.1f,%.1f"|format(px, py)) %}
        {% set _ = points_area.append("%.1f,%.1f"|format(px, py)) %}
      {% endfor %}
      {# Area polygon #}
      <polygon points="{{ points_area|join(' ') }} {{ pad_x + step_x * (values|length - 1) }},{{ pad_y + plot_h }} {{ pad_x }},{{ pad_y + plot_h }}"
               fill="#1d6387" fill-opacity="0.10"/>
      {# Line #}
      <polyline points="{{ points_line|join(' ') }}"
                fill="none" stroke="#1d6387" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>
      {# Data points and labels #}
      {% for v in values %}
        {% set px = pad_x + step_x * loop.index0 %}
        {% set py = pad_y + plot_h - (plot_h * ((v - v_min) / v_range)) %}
        <circle cx="{{ "%.1f"|format(px) }}" cy="{{ "%.1f"|format(py) }}" r="3"
                fill="{% if loop.last %}#1d6387{% else %}#4d9fb5{% endif %}" stroke="#fff" stroke-width="1"/>
        <text x="{{ "%.1f"|format(px) }}" y="{{ "%.1f"|format(py - 5) }}"
              text-anchor="middle" fill="#1a3148" font-size="8" font-weight="{% if loop.last %}700{% else %}400{% endif %}">{{ v }}{{ suffix }}</text>
      {% endfor %}
    </svg>
  </div>
  {% endif %}
{% endmacro %}

{# ── Macro: bar chart for count metrics ───────────────────────── #}
{% macro bar_chart(metric_key, title, color_good_down=false) %}
  {% set values = [] %}
  {% for pt in tl %}
    {% if pt[metric_key] is defined and pt[metric_key] is not none %}
      {% set _ = values.append(pt[metric_key]) %}
    {% endif %}
  {% endfor %}
  {% if values|length >= 2 %}
  {% set v_max = values|max if values|max > 0 else 1 %}
  {% set bar_gap = 4 %}
  {% set total_gap = bar_gap * (values|length - 1) %}
  {% set bar_w = (plot_w - total_gap) / values|length %}
  {% set bar_w = [bar_w, 28]|min %}
  {% set total_bars_w = bar_w * values|length + bar_gap * (values|length - 1) %}
  {% set offset_x = pad_x + (plot_w - total_bars_w) / 2 %}
  <div class="trend-chart-card">
    <div class="chart-title">{{ title }}</div>
    <svg xmlns="http://www.w3.org/2000/svg" width="{{ cw }}" height="{{ ch }}" viewBox="0 0 {{ cw }} {{ ch }}">
      {# Baseline #}
      <line x1="{{ pad_x }}" y1="{{ pad_y + plot_h }}" x2="{{ pad_x + plot_w }}" y2="{{ pad_y + plot_h }}" stroke="#e2e8f0" stroke-width="0.5"/>
      {% for v in values %}
        {% set bar_h = plot_h * (v / v_max) if v_max > 0 else 0 %}
        {% set bar_h = [bar_h, 2]|max %}
        {% set bx = offset_x + loop.index0 * (bar_w + bar_gap) %}
        {% set by = pad_y + plot_h - bar_h %}
        {# Color: last bar uses primary, others use lighter shade #}
        {% if loop.last %}
          {% set bar_color = "#1d6387" %}
        {% else %}
          {% set bar_color = "#4d9fb5" %}
        {% endif %}
        {# If lower is better and value decreased, show green on last bar #}
        {% if color_good_down and loop.last and values|length > 1 and v < values[-2] %}
          {% set bar_color = "#22c55e" %}
        {% elif color_good_down and loop.last and values|length > 1 and v > values[-2] %}
          {% set bar_color = "#ef4444" %}
        {% endif %}
        <rect x="{{ "%.1f"|format(bx) }}" y="{{ "%.1f"|format(by) }}" width="{{ "%.1f"|format(bar_w) }}" height="{{ "%.1f"|format(bar_h) }}"
              rx="2" fill="{{ bar_color }}"/>
        <text x="{{ "%.1f"|format(bx + bar_w / 2) }}" y="{{ "%.1f"|format(by - 4) }}"
              text-anchor="middle" fill="#1a3148" font-size="8" font-weight="{% if loop.last %}700{% else %}400{% endif %}">{{ v }}</text>
      {% endfor %}
    </svg>
  </div>
  {% endif %}
{% endmacro %}

<div class="trend-charts">
  {{ line_chart("mfa_coverage_pct", t.trend_mfa_coverage, "%", 100) }}
  {{ line_chart("risk_score", t.trend_risk_score, "", 100) }}
  {{ line_chart("secure_score_pct", t.trend_secure_score, "%", 100) }}
  {{ bar_chart("users_no_mfa", t.users_without_mfa, true) }}
</div>
{% endif %}

{% endif %}

{% if radar_svg and '<svg' in radar_svg %}
<div style="display:flex;gap:32px;align-items:center;margin-bottom:32px;">
  <div style="flex:1;">{{ radar_svg | safe }}</div>
  <div style="flex:1;">
    {% for cat, score in risk_radar.items() %}
    <div style="display:flex;align-items:center;gap:12px;padding:8px 0;border-bottom:1px solid var(--border);">
      <span style="font-size:13px;width:80px;">{{ cat }}</span>
      <div style="flex:1;height:8px;background:var(--border);border-radius:4px;">
        <div style="height:100%;border-radius:4px;width:{{ score }}%;background:{% if score >= 75 %}var(--green){% elif score >= 50 %}var(--orange){% else %}var(--red){% endif %};"></div>
      </div>
      <span style="font-size:13px;font-weight:700;width:32px;text-align:right;color:{% if score >= 75 %}var(--green){% elif score >= 50 %}var(--orange){% else %}var(--red){% endif %};">{{ score }}</span>
    </div>
    {% endfor %}
  </div>
</div>
{% endif %}

<!-- Metrics row 1 -->
<div class="metrics">
  <div class="metric-card{% if not users.has_data %} metric-card-invalid{% endif %}">
    <div class="icon">&#x1F464;</div>
    {% if users.has_data %}
    <div class="num brand">{{ users.total }}</div>
    <div class="lbl">{{ t.total_users_label }}</div>
    <div class="sublbl">{{ t('active_n_disabled', enabled=users.enabled, disabled=users.disabled) }}</div>
    {% else %}
    <div class="num" style="color:#9ca3af;">{{ t.data_unavailable_short }}</div>
    <div class="lbl">{{ t.total_users_label }}</div>
    <div class="sublbl" style="color:#9ca3af;">{{ t.data_unavailable }}</div>
    {% endif %}
  </div>
  <div class="metric-card{% if not mfa.has_data %} metric-card-invalid{% endif %}">
    <div class="icon">&#x1F510;</div>
    {% if mfa.has_data %}
    <div class="num {% if mfa.pct >= 95 %}green{% elif mfa.pct >= 80 %}orange{% else %}red{% endif %}">{{ mfa.pct | round(0) | int }}%</div>
    <div class="lbl">{{ t.mfa_coverage }}</div>
    <div class="pbar"><div class="pbar-fill {% if mfa.pct >= 95 %}green{% elif mfa.pct >= 80 %}orange{% else %}red{% endif %}" style="width:{{ mfa.pct }}%"></div></div>
    {% else %}
    <div class="num" style="color:#9ca3af;">{{ t.data_unavailable_short }}</div>
    <div class="lbl">{{ t.mfa_coverage }}</div>
    <div class="sublbl" style="color:#9ca3af;">{{ t.data_unavailable }}</div>
    {% endif %}
  </div>
  <div class="metric-card">
    <div class="icon">&#x1F3C6;</div>
    <div class="num {% if secure_score.pct >= 75 %}green{% elif secure_score.pct >= 50 %}orange{% else %}red{% endif %}">{{ secure_score.pct | round(0) | int }}%</div>
    <div class="lbl">{{ t.microsoft_secure_score }}</div>
    <div class="pbar"><div class="pbar-fill {% if secure_score.pct >= 75 %}green{% elif secure_score.pct >= 50 %}orange{% else %}red{% endif %}" style="width:{{ secure_score.pct }}%"></div></div>
  </div>
</div>

<!-- Metrics row 2 -->
<div class="metrics" style="margin-bottom:40px;">
  {% if intune and intune.total > 0 %}
  <div class="metric-card">
    <div class="icon">&#x1F4BB;</div>
    <div class="num {% if intune.compliance_pct >= 90 %}green{% elif intune.compliance_pct >= 70 %}orange{% else %}red{% endif %}">{{ intune.compliance_pct | round(0) | int }}%</div>
    <div class="lbl">{{ t.device_compliance }}</div>
    <div class="pbar"><div class="pbar-fill {% if intune.compliance_pct >= 90 %}green{% elif intune.compliance_pct >= 70 %}orange{% else %}red{% endif %}" style="width:{{ intune.compliance_pct }}%"></div></div>
  </div>
  {% endif %}
  <div class="metric-card">
    <div class="icon">&#x1F6E1;</div>
    <div class="num brand">{{ ca.enabled }}</div>
    <div class="lbl">{{ t.ca_rules }}</div>
    <div class="sublbl">{{ t('n_report_mode', count=ca.report_only) }}</div>
  </div>
  {% if admin_roles %}
  <div class="metric-card">
    <div class="icon">&#x1F511;</div>
    <div class="num {% if admin_roles.global_admin_count > 4 %}red{% elif admin_roles.global_admin_count > 2 %}orange{% else %}green{% endif %}">{{ admin_roles.global_admin_count }}</div>
    <div class="lbl">{{ t.global_admins }}</div>
    <div class="sublbl">{{ t('n_role_assignments_total', count=admin_roles.total_assignments) }}</div>
