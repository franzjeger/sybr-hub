  </div>
</div>

{% if fg.admins %}
<h4 style="margin-top:16px;">Administratorer</h4>
<table class="data-table" style="width:100%; font-size:12px;">
  <thead><tr><th>Navn</th><th>Profil</th><th>2FA</th><th>IP-begrensning</th></tr></thead>
  <tbody>
    {% for a in fg.admins %}
    <tr>
      <td>{{ a.name }}</td>
      <td>{{ a.profile }}</td>
      <td style="color: {{ 'green' if a.two_factor else 'var(--red, red)' }};">{{ '✓' if a.two_factor else '✗' }}</td>
      <td style="color: {{ 'green' if a.trusthost else 'var(--orange, orange)' }};">{{ '✓' if a.trusthost else '✗' }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

{% if fg.policy_warnings %}
<h4 style="margin-top:16px;">Brannmur-advarsler</h4>
<ul style="font-size:12px;">
  {% for w in fg.policy_warnings %}
  <li style="color: var(--red, red);">{{ w }}</li>
  {% endfor %}
</ul>
{% endif %}
{% endif %}

{% if network.unifi and 'error' not in network.unifi %}
{% set uf = network.unifi %}
<h3 style="margin-top:24px;">{{ t.section_unifi }}</h3>
<div class="metrics">
  <div class="metric-card">
    <div class="num brand">{{ uf.device_count | default(0) }}</div>
    <div class="lbl">Enheter</div>
  </div>
  {% if uf.mode == 'controller' %}
  <div class="metric-card">
    <div class="num brand">{{ uf.wlan_count | default(0) }}</div>
    <div class="lbl">SSID-er</div>
  </div>
  <div class="metric-card">
    <div class="num brand">{{ uf.network_count | default(0) }}</div>
    <div class="lbl">Nettverk</div>
  </div>
  <div class="metric-card">
    <div class="num brand">{{ uf.firewall_rules | default(0) }}</div>
    <div class="lbl">Brannmurregler</div>
  </div>
  <div class="metric-card">
    <div class="num {{ 'red' if (uf.active_alarms | default(0)) > 0 else 'green' }}">{{ uf.active_alarms | default(0) }}</div>
    <div class="lbl">Aktive alarmer</div>
  </div>
  {% endif %}
  {% if uf.mode == 'direct' %}
  <div class="metric-card">
    <div class="num {{ 'green' if uf.reachable == uf.device_count else 'orange' }}">{{ uf.reachable | default(0) }}</div>
    <div class="lbl">Tilgjengelige</div>
  </div>
  {% if uf.default_creds_count | default(0) > 0 %}
  <div class="metric-card">
    <div class="num red">{{ uf.default_creds_count }}</div>
    <div class="lbl">Standard-passord</div>
  </div>
  {% endif %}
  {% if uf.outdated_firmware_count | default(0) > 0 %}
  <div class="metric-card">
    <div class="num orange">{{ uf.outdated_firmware_count }}</div>
    <div class="lbl">Utdatert firmware</div>
  </div>
  {% endif %}
  {% if uf.eol_count | default(0) > 0 %}
  <div class="metric-card">
    <div class="num red">{{ uf.eol_count }}</div>
    <div class="lbl">End-of-life</div>
  </div>
  {% endif %}
  {% endif %}
</div>

{% if uf.devices %}
<h4 style="margin-top:16px;">Enhetsoversikt</h4>
<table class="data-table" style="width:100%; font-size:12px;">
  <thead>
    <tr>
      <th>Enhet</th>
      <th>Modell</th>
      <th>Firmware</th>
      {% if uf.mode == 'controller' %}<th>Klienter</th><th>Status</th>
      {% else %}<th>MAC</th><th>Status</th>{% endif %}
    </tr>
  </thead>
  <tbody>
    {% for d in uf.devices %}
    <tr>
      <td>{{ d.name or d.hostname or d.label or d.host or '–' }}</td>
      <td>{{ d.model or '–' }}</td>
      <td style="font-family: monospace; font-size:11px;">{{ d.firmware or '–' }}</td>
      {% if uf.mode == 'controller' %}
      <td>{{ d.clients | default(0) }}</td>
      <td style="color: {{ 'green' if d.status == 'online' else 'var(--red, red)' }};">{{ d.status | default('–') }}</td>
      {% else %}
      <td style="font-family: monospace; font-size:11px;">{{ d.mac or '–' }}</td>
      <td style="color: {{ 'green' if d.ok else 'var(--red, red)' }};">{{ 'Online' if d.ok else (d.error or 'Offline') }}</td>
      {% endif %}
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

{% if uf.mode == 'controller' and uf.wlans %}
<h4 style="margin-top:16px;">Trådløse nettverk</h4>
<table class="data-table" style="width:100%; font-size:12px;">
  <thead><tr><th>SSID</th><th>Sikkerhet</th><th>Gjest</th><th>Aktiv</th></tr></thead>
  <tbody>
    {# Three states, not two. Colouring "anything that isn't 'open'" green
       painted an unreadable security field as a secured network. #}
    {% for w in uf.wlans %}
    {% set sec = (w.security_label or w.security or 'Unknown') | string %}
    <tr>
      <td>{{ w.name }}</td>
      <td style="color: {% if sec|lower == 'open' or 'WEP' in sec %}var(--red, red){% elif 'Unknown' in sec %}var(--orange, #b45309){% else %}green{% endif %};">{{ sec }}</td>
      <td>{{ 'Ja' if w.guest else 'Nei' }}</td>
      <td>{{ 'Ja' if w.enabled else 'Nei' }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endif %}

{% endif %}
{% endif %}

