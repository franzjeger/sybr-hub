<!-- ── Azure ── -->
{% if azure and azure.has_data %}
<div class="section-label" style="margin-top:56px;" id="azure">{{ t.azure_infrastructure }}</div>
<h2><a href="#azure" class="section-anchor">{{ t.azure_resources }}</a></h2>
<p class="section-intro">{{ t.azure_intro }}</p>

<div class="metrics">
  <div class="metric-card">
    <div class="num brand">{{ azure.subscriptions | length }}</div>
    <div class="lbl">{{ t.subscriptions }}</div>
  </div>
  <div class="metric-card">
    <div class="num brand">{{ azure.total_resources }}</div>
    <div class="lbl">{{ t.total_resources }}</div>
  </div>
  <div class="metric-card">
    <div class="num brand">{{ azure.vms | length }}</div>
    <div class="lbl">{{ t.virtual_machines }}</div>
  </div>
</div>

{% if azure.subscriptions %}
<div class="env-card">
  <h4>{{ t.subscriptions }}</h4>
  {% for s in azure.subscriptions %}
  <div class="env-row">
    <span>{{ s.name }}</span>
    <span><span class="status-pill {% if s.state == 'Enabled' %}ok{% else %}warning{% endif %}">{{ s.state }}</span></span>
  </div>
  {% endfor %}
</div>
{% endif %}

{% if azure.vms %}
<div class="env-card">
  <h4>{{ t.virtual_machines }}</h4>
  <table class="email-table">
    <tr><th>{{ t.vm_label }}</th><th>Subscription</th><th>{{ t.location }}</th><th>{{ t.os_label }}</th><th>{{ t.size_label }}</th></tr>
    {% for vm in azure.vms %}
    <tr>
      <td style="font-weight:600;">{{ vm.name }}</td>
      <td style="font-size:11px;">{{ vm.subscription }}</td>
