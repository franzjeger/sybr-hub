      <td style="font-size:11px;">{{ vm.size }}</td>
    </tr>
    {% endfor %}
  </table>
</div>
{% endif %}

{% if backup_coverage and backup_coverage.vms_total > 0 %}
<div class="env-card">
  <h4>{{ t.backup_coverage }}</h4>
  <div class="env-row"><span>{{ t.vms_total }}</span><span>{{ backup_coverage.vms_total }}</span></div>
  {# Without vault data the with/without split is 0/0, which reads as "nothing
     is unprotected". Say what actually happened instead. #}
  {% if not backup_coverage.coverage_known %}
  <div style="margin-top:8px;padding:8px 12px;background:var(--orange-bg, #fff7ed);border:1px solid var(--orange-bd, #fed7aa);border-radius:8px;font-size:12px;">
    {{ t.backup_coverage_unknown }}
  </div>
  {% else %}
  <div class="env-row"><span>{{ t.with_backup }}</span><span style="color:var(--green);">{{ backup_coverage.vms_backed_up }}</span></div>
  <div class="env-row"><span>{{ t.without_backup }}</span>
    <span style="{% if backup_coverage.vms_not_backed_up %}color:var(--red);font-weight:700;{% endif %}">
      {{ backup_coverage.vms_not_backed_up | length }}
    </span>
  </div>
  {% endif %}
  {% if backup_coverage.vms_not_backed_up %}
  <div style="margin-top:8px;padding:8px 12px;background:var(--red-bg);border:1px solid var(--red-bd);border-radius:8px;font-size:12px;">
    <strong style="color:var(--red);">{{ t.vms_without_backup }}</strong>
    {{ backup_coverage.vms_not_backed_up | join(', ') }}
  </div>
  {% endif %}
</div>
{% endif %}

{% if azure.per_sub %}
<div class="env-grid">
  {% for sub in azure.per_sub %}
  {% if sub.resources > 0 %}
  <div class="env-card">
    <h4>{{ sub.name }} ({{ t('n_resources', count=sub.resources) }})</h4>
    {% for rtype, count in sub.types[:8] %}
    <div class="env-row"><span style="font-size:11px;">{{ rtype.split('/')[-1] }}</span><span>{{ count }}</span></div>
    {% endfor %}
    {% if sub.types | length > 8 %}
    <div class="env-row"><span style="font-size:11px;color:var(--muted);">{{ t('n_more', count=sub.types|length - 8) }}</span><span></span></div>
    {% endif %}
  </div>
  {% endif %}
  {% endfor %}
</div>
{% endif %}

{% if azure.resource_types_list %}
<div class="env-card">
  <h4>{{ t.resource_types_total }}</h4>
  <table class="email-table">
    <tr><th>{{ t.type_label }}</th><th style="text-align:right;">{{ t.count }}</th></tr>
    {% for rt in azure.resource_types_list[:15] %}
    <tr>
      <td style="font-size:12px;">{{ rt.type }}</td>
      <td style="text-align:right;font-weight:600;">{{ rt.count }}</td>
    </tr>
    {% endfor %}
    {% if azure.resource_types_list | length > 15 %}
    <tr><td colspan="2" style="font-size:11px;color:var(--muted);">{{ t('and_n_more_types', count=azure.resource_types_list|length - 15) }}</td></tr>
    {% endif %}
  </table>
</div>
{% endif %}
{% endif %}

