    <div class="lbl">{{ t.sensitivity_labels }}{% if purview.sensitivity_labels_unavailable %}<br><span style="font-size:10px;color:var(--muted);">{{ t.not_measured }}</span>{% endif %}</div>
  </div>
  <div class="metric-card">
    <div class="num brand">{% if purview.dlp_unavailable %}<span style="color:var(--muted);" title="{{ t.not_measured_note }}">&ndash;</span>{% else %}{{ purview.dlp_policy_count }}{% endif %}</div>
    <div class="lbl">{{ t.dlp_policies }}{% if purview.dlp_unavailable %}<br><span style="font-size:10px;color:var(--muted);">{{ t.not_measured }}</span>{% endif %}</div>
  </div>
  <div class="metric-card">
    <div class="num brand">{% if purview.retention_unavailable %}<span style="color:var(--muted);" title="{{ t.not_measured_note }}">&ndash;</span>{% else %}{{ purview.retention_policy_count }}{% endif %}</div>
    <div class="lbl">{{ t.retention_policies }}{% if purview.retention_unavailable %}<br><span style="font-size:10px;color:var(--muted);">{{ t.not_measured }}</span>{% endif %}</div>
