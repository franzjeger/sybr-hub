<!-- ── 3. Recommendations ── -->
{% if recommendations %}
<div class="section-label" style="margin-top:56px;" id="anbefalinger">{{ t.recommendations }}</div>
<h2><a href="#anbefalinger" class="section-anchor">{{ t.what_we_recommend }}</a></h2>
<p class="section-intro">{{ t.recommendations_intro }}</p>

{% for rec in recommendations %}
<div class="rec" id="rec-{{ loop.index }}">
  <div class="rec-num">{{ loop.index }}</div>
  <div class="rec-body">
    <h4>{{ rec.title }}</h4>
    <p>{{ rec.detail }}{% if rec.doc_url is defined and rec.doc_url %} <a href="{{ rec.doc_url }}" target="_blank" rel="noopener" style="font-size:11px;color:var(--blue);white-space:nowrap;">Microsoft Learn &rarr;</a>{% endif %}</p>
    {% if rec.sub_items is defined and rec.sub_items %}
    <div class="rec-expand" onclick="this.classList.toggle('open');this.nextElementSibling.classList.toggle('open')">
      <span class="arrow">&#x25B6;</span> {{ t('show_all_n_details', count=rec.sub_items|length) }}
    </div>
    <div class="rec-sub-items">
      {% for item in rec.sub_items %}
      <div class="rec-sub-item">{{ item }}</div>
      {% endfor %}
    </div>
    {% endif %}
    {% if rec.finding_id is defined and rec.finding_id %}<a href="#{{ rec.finding_id }}" class="rec-finding-link">↑ {{ t.related_finding }}</a>{% endif %}
  </div>
  <div class="rec-effort">
    <div>
      {% if rec.priority == 'critical' %}<span class="badge critical">{{ t.critical }}</span>
      {% elif rec.priority == 'high' %}<span class="badge warning">{{ t.high }}</span>
      {% elif rec.priority == 'low' %}<span style="background:#f3f4f6;color:#6b7280;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700;">{{ t.low }}</span>
      {% else %}<span class="badge medium">{{ t.medium }}</span>{% endif %}
    </div>
    <div class="eff" style="margin-top:4px;">{{ t('effort_label', effort=rec.effort) }}</div>
  </div>
</div>
{% endfor %}
{% endif %}


