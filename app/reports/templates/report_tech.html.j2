<div class="tab-panel" id="tab-azure">
<!-- ══════════════════════════════════════════════════════════════════════ -->
<h2 id="azure">{{ t.azure_infrastructure }}</h2>

{% if azure and azure.has_data %}

<!-- Summary -->
<div class="summary-bar" style="grid-template-columns:repeat(5,1fr);">
  <div class="stat-box blue"><div class="num">{{ azure.subscriptions | length }}</div><div class="lbl">{{ t.subscriptions }}</div></div>
  <div class="stat-box blue"><div class="num">{{ azure.total_resources }}</div><div class="lbl">{{ t.resources_header }}</div></div>
  <div class="stat-box blue"><div class="num">{{ azure.vms | length }}</div><div class="lbl">{{ t.vms_header }}</div></div>
  <div class="stat-box {% if azure.advisor_recs > 0 %}orange{% else %}green{% endif %}"><div class="num">{{ azure.advisor_recs }}</div><div class="lbl">{{ t.advisor_recs }}</div></div>
  <div class="stat-box {% if azure.orphaned > 0 %}orange{% else %}green{% endif %}"><div class="num">{{ azure.orphaned }}</div><div class="lbl">{{ t.orphaned_label }}</div></div>
</div>

{% if azure.subscriptions %}
<h3>{{ t.subscriptions }} ({{ azure.subscriptions | length }})</h3>
<table>
  <tr><th>{{ t.subscription }}</th><th>ID</th><th>{{ t.status }}</th></tr>
  {% for s in azure.subscriptions %}
  <tr>
    <td style="font-weight:600;">{{ s.name }}</td>
    <td style="font-family:var(--mono);font-size:11px;">{{ s.id }}</td>
    <td><span class="tag {% if s.state == 'Enabled' %}ok{% else %}warning{% endif %}">{{ s.state }}</span></td>
  </tr>
  {% endfor %}
</table>
{% endif %}

<!-- Per-subscription breakdown -->
{% if azure.per_sub %}
<h3>{{ t.resources_per_sub }}</h3>
{% for sub in azure.per_sub %}
<div class="card" style="margin-bottom:12px;">
  <div class="card-title">{{ sub.name }} &mdash; {{ t('n_resources', count=sub.resources) }}</div>
  {% if sub.types %}
  <table>
    <tr><th>{{ t.resource_type_header }}</th><th style="text-align:right;">{{ t.count_header }}</th></tr>
    {% for rtype, count in sub.types[:15] %}
    <tr>
      <td style="font-family:var(--mono);font-size:11px;">{{ rtype }}</td>
      <td style="text-align:right;font-family:var(--mono);">{{ count }}</td>
    </tr>
    {% endfor %}
    {% if sub.types | length > 15 %}
    <tr><td colspan="2" style="color:var(--muted);font-size:11px;">{{ t('and_n_more', count=sub.types|length - 15) }}</td></tr>
    {% endif %}
  </table>
  {% endif %}
  {% if sub.rgs %}
  <div style="margin-top:8px;font-size:11px;color:var(--muted);">
    {{ t.resource_groups_label }}: {% for rg in sub.rgs %}{{ rg.name }} ({{ rg.count }}){% if not loop.last %}, {% endif %}{% endfor %}
  </div>
  {% endif %}
</div>
{% endfor %}
{% endif %}

{% if azure.vms %}
<h3>{{ t('virtual_machines_n', count=azure.vms|length) }}</h3>
<table>
  <tr><th>VM</th><th>{{ t.subscription }}</th><th>{{ t.resource_group_header }}</th><th>{{ t.location_header }}</th><th>{{ t.os_header }}</th><th>{{ t.size_header }}</th><th>{{ t.status }}</th></tr>
  {% for vm in azure.vms %}
  <tr>
    <td style="font-weight:500;">{{ vm.name }}</td>
    <td style="font-size:11px;color:var(--muted);">{{ vm.subscription }}</td>
    <td style="font-size:11px;">{{ vm.rg }}</td>
    <td>{{ vm.location }}</td>
    <td>{{ vm.os }}</td>
    <td style="font-family:var(--mono);font-size:11px;">{{ vm.size }}</td>
    <td><span class="tag {% if vm.status == 'running' %}ok{% elif vm.status == 'deallocated' %}skip{% else %}warning{% endif %}">{{ vm.status or 'N/A' }}</span></td>
  </tr>
  {% endfor %}
</table>
{% endif %}

{% if azure.storage_accounts %}
<h3>{{ t('storage_accounts_n', count=azure.storage_accounts|length) }}</h3>
<table>
  <tr><th>{{ t.account_header }}</th><th>{{ t.subscription }}</th><th>SKU</th><th>{{ t.type }}</th></tr>
  {% for sa in azure.storage_accounts %}
  <tr>
    <td style="font-weight:500;font-family:var(--mono);font-size:12px;">{{ sa.name }}</td>
    <td style="font-size:11px;color:var(--muted);">{{ sa.subscription }}</td>
    <td>{{ sa.sku }}</td>
    <td>{{ sa.kind }}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}

{% if azure.resource_types_list %}
<h3>{{ t.all_resource_types }}</h3>
<table>
  <tr><th>{{ t.type }}</th><th style="text-align:right;">{{ t.count_header }}</th></tr>
  {% for rt in azure.resource_types_list %}
  <tr>
    <td style="font-family:var(--mono);font-size:11px;">{{ rt.type }}</td>
    <td style="text-align:right;font-family:var(--mono);">{{ rt.count }}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}

<!-- Azure raw data sections (all azure files) -->
{% for key in file_contents.keys() | sort %}
{% if (key.startswith('50_') or key.startswith('50b_') or key.startswith('51_') or key.startswith('52_') or key.startswith('53_') or key.startswith('61_') or key.startswith('32b_')) and key.endswith('.txt') %}
{% if file_contents.get(key, '') and file_contents.get(key, '').strip() and 'Error' not in file_contents.get(key, '')[:20] %}
<div class="data-section">
  <div class="data-header collapsed" onclick="toggleDataSection(this)">
    <span class="toggle">&#x25BC;</span>
    <span>{{ key.replace('.txt','').replace('_',' ').title() }}</span>
    <span class="fn">{{ key }}</span>
  </div>
  <div class="data-body collapsed">{{ file_contents.get(key, '') }}</div>
</div>
{% endif %}
{% endif %}
{% endfor %}

{% else %}
<div class="alert info"><strong>{{ t.no_azure_data }}</strong>{{ t.no_azure_desc }}</div>
{% endif %}

</div><!-- /tab-azure -->

<div class="tab-panel" id="tab-findings">
<!-- ══════════════════════════════════════════════════════════════════════ -->
<!-- ── 14. Critical Findings ── -->
<a name="kritiske"></a><h2 id="kritiske">{{ t.critical_findings }}</h2>

{% if defender_alerts and 'No active' not in defender_alerts and defender_alerts.strip() %}
<div class="alert critical"><strong>&#x1F534; {{ t.active_defender_alerts }}</strong></div>
<div class="data-section">
  <div class="data-header"><span>Defender Alerts</span><span class="fn">19b_defender_active_alerts.txt</span></div>
  <div class="data-body">{{ defender_alerts }}</div>
</div>
{% endif %}

{% if ext_fwd_warn and ext_fwd_warn.strip() %}
<div class="alert critical"><strong>&#x1F534; {{ t.external_fwd_detected }}</strong></div>
<div class="data-section">
  <div class="data-header"><span>{{ t.external_forwarding }}</span></div>
  <div class="data-body">{{ ext_fwd_warn }}</div>
</div>
{% endif %}

{% if inbox_rule_warn and inbox_rule_warn.strip() %}
<div class="alert critical"><strong>&#x1F534; {{ t.inbox_rules_ext_fwd_detected }}</strong></div>
<div class="data-section">
  <div class="data-header"><span>{{ t.inbox_rules_ext_fwd_header }}</span></div>
  <div class="data-body">{{ inbox_rule_warn }}</div>
</div>
{% endif %}

{% if risky_users and 'No risky' not in risky_users and risky_users.strip() %}
<div class="alert warning"><strong>&#x26A0; {{ t.risky_users_idp }}</strong></div>
<div class="data-section">
  <div class="data-header"><span>{{ t.risky_users_header }}</span><span class="fn">18_risky_users.txt</span></div>
  <div class="data-body">{{ risky_users }}</div>
</div>
{% endif %}

{% if all_warns %}
<h3>{{ t.all_warnings }}</h3>
<table>
  <tr><th>{{ t.warning_header }}</th></tr>
  {% for w in all_warns %}
  <tr><td style="color:var(--orange);">&#x26A0; {{ w }}</td></tr>
  {% endfor %}
</table>
{% endif %}

{% if not (defender_alerts and 'No active' not in defender_alerts) and not ext_fwd_warn and not inbox_rule_warn and not (risky_users and 'No risky' not in risky_users) and not all_warns %}
<div class="alert ok"><strong>&#x2713; {{ t.no_critical_findings }}</strong>{{ t.no_critical_desc }}</div>
{% endif %}

</div><!-- /tab-findings -->

<div class="tab-panel" id="tab-rawdata">
<!-- ══════════════════════════════════════════════════════════════════════ -->
<!-- ── 15. Raw Data ── -->
<a name="rawdata"></a><h2 id="rawdata">{{ t.raw_data }}</h2>
<p style="color:var(--muted);margin-bottom:20px;font-size:12px;">{{ t.raw_data_desc }}</p>

{% for filename, content in file_contents.items() | sort %}
{# The anchor the evidence links in the compliance table point at. #}
<div class="data-section" id="raw-{{ filename }}">
  <div class="data-header collapsed" onclick="toggleDataSection(this)">
    <span class="toggle">&#x25BC;</span>
    <span>{{ filename.replace('.txt','').replace('_',' ').title() }}</span>
    <span class="fn">{{ filename }}</span>
  </div>
  <div class="data-body collapsed">{{ content }}</div>
</div>
{% endfor %}

</div><!-- /tab-rawdata -->

<div class="footer">
  <span style="display:flex;align-items:center;gap:8px;">
    {% if logo_dark %}<img src="{{ logo_dark }}" alt="SYBR" style="height:22px;">{% endif %}
    {{ branding.company_name if branding is defined and branding.company_name else 'SYBR AS' }} &mdash; {{ t.report_title_tech }}
  </span>
  <span>{{ customer_name }} &middot; {{ report_date }} &middot; {{ app_version }}</span>
</div>

</div>

<script>
// Fix anchor navigation — activate parent tab first, then scroll
document.addEventListener('click', function(e) {
  var a = e.target.closest('a[href^="#"]');
  if (!a) return;
  e.preventDefault();
  var id = a.getAttribute('href').substring(1);
  var el = document.getElementById(id);
  if (!el) return;
  // Find parent tab-panel and activate it
  var panel = el.closest('.tab-panel');
  if (panel && !panel.classList.contains('active')) {
    document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active'); });
    panel.classList.add('active');
    // Highlight correct tab button
    var tabId = panel.id.replace('tab-', '');
    document.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.remove('active'); });
    var btns = document.querySelectorAll('.tab-btn');
    btns.forEach(function(b) { if (b.textContent && b.getAttribute('onclick') && b.getAttribute('onclick').indexOf(tabId) !== -1) b.classList.add('active'); });
  }
  setTimeout(function() { el.scrollIntoView({behavior: 'smooth'}); }, 50);
});
// Tab switching
function switchTab(name) {
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  const panel = document.getElementById('tab-' + name);
  if (panel) panel.classList.add('active');
  event.target.classList.add('active');
}

// Collapsible data sections
function toggleDataSection(header) {
  header.classList.toggle('collapsed');
  const body = header.nextElementSibling;
  body.classList.toggle('collapsed');
}

// Search
let searchTimeout = null;
const SEARCH_HITS_TEMPLATE = {{ t.search_hits | tojson }};
const NO_RESULTS_TEXT = {{ t.no_results | tojson }};

function handleSearch(query) {
  clearTimeout(searchTimeout);
  const countEl = document.getElementById('searchCount');
  const resultsEl = document.getElementById('searchResults');

  if (!query || query.length < 2) {
    countEl.textContent = '';
    resultsEl.classList.remove('visible');
    resultsEl.innerHTML = '';
    return;
  }

  // Debounce for performance
  searchTimeout = setTimeout(() => doSearch(query), 150);
}

function doSearch(query) {
  const countEl = document.getElementById('searchCount');
  const resultsEl = document.getElementById('searchResults');
  const qLower = query.toLowerCase();
  const results = [];

  // Search all searchable elements: tables, data sections, alerts, cards
  const searchTargets = [
    ...document.querySelectorAll('.data-section'),
    ...document.querySelectorAll('table'),
    ...document.querySelectorAll('.alert'),
    ...document.querySelectorAll('.card'),
    ...document.querySelectorAll('.stat-box'),
  ];

  // Also search all h2/h3 headings and their sibling content
  document.querySelectorAll('h2, h3').forEach(heading => {
    const section = heading;
    const text = [];
    let sibling = heading.nextElementSibling;
    // Collect text from siblings until next heading
    while (sibling && !['H2','H3'].includes(sibling.tagName)) {
      text.push(sibling.textContent || '');
      sibling = sibling.nextElementSibling;
    }
    const fullText = (heading.textContent + ' ' + text.join(' ')).toLowerCase();
    if (fullText.includes(qLower)) {
      // Extract preview around match
      const idx = fullText.indexOf(qLower);
      const start = Math.max(0, idx - 40);
      const end = Math.min(fullText.length, idx + query.length + 60);
      let preview = fullText.substring(start, end).trim();
      // Highlight match in preview
      const matchIdx = preview.toLowerCase().indexOf(qLower);
      if (matchIdx >= 0) {
        preview = escapeHtml(preview.substring(0, matchIdx))
          + '<mark>' + escapeHtml(preview.substring(matchIdx, matchIdx + query.length)) + '</mark>'
          + escapeHtml(preview.substring(matchIdx + query.length));
      }
      results.push({
        title: heading.textContent.trim(),
        preview: preview,
        element: heading,
        tab: heading.closest('.tab-panel'),
      });
    }
  });

  // Search data sections specifically
  document.querySelectorAll('.data-section').forEach(section => {
    const body = section.querySelector('.data-body');
    const header = section.querySelector('.data-header');
    if (!body) return;
    const text = body.textContent.toLowerCase();
    if (!text.includes(qLower)) return;

    const titleEl = header ? header.querySelector('span:not(.fn):not(.toggle)') : null;
    const title = titleEl ? titleEl.textContent.trim() : 'Data';
    const fn = header ? (header.querySelector('.fn') || {}).textContent || '' : '';

    // Find matching line for preview
    const bodyLines = body.textContent.split('\n');
    let preview = '';
    for (const line of bodyLines) {
      if (line.toLowerCase().includes(qLower)) {
        const trimmed = line.trim().substring(0, 120);
        const idx = trimmed.toLowerCase().indexOf(qLower);
        if (idx >= 0) {
          preview = escapeHtml(trimmed.substring(0, idx))
            + '<mark>' + escapeHtml(trimmed.substring(idx, idx + query.length)) + '</mark>'
            + escapeHtml(trimmed.substring(idx + query.length));
        } else {
          preview = escapeHtml(trimmed);
        }
        break;
      }
    }

    results.push({
      title: title + (fn ? ' (' + fn + ')' : ''),
      preview: preview,
      element: section,
      tab: section.closest('.tab-panel'),
      isDataSection: true,
      header: header,
      body: body,
    });
  });

  // Deduplicate by element
  const seen = new Set();
  const unique = results.filter(r => {
    if (seen.has(r.element)) return false;
    seen.add(r.element);
    return true;
  });

  countEl.textContent = SEARCH_HITS_TEMPLATE.replace('{count}', unique.length).replace('{query}', query);

  if (unique.length === 0) {
    resultsEl.innerHTML = '<div style="padding:16px;color:var(--muted);font-size:13px;">' + NO_RESULTS_TEXT + '</div>';
    resultsEl.classList.add('visible');
    return;
  }

  resultsEl.innerHTML = unique.slice(0, 25).map((r, i) =>
    '<div class="search-result-item" onclick="navigateToResult(' + i + ')">' +
    '<div class="search-result-title">' + escapeHtml(r.title) + '</div>' +
    (r.preview ? '<div class="search-result-preview">' + r.preview + '</div>' : '') +
    '</div>'
  ).join('');
  resultsEl.classList.add('visible');

  // Store results for navigation
  window._searchResults = unique;
}

function navigateToResult(idx) {
  const r = window._searchResults[idx];
  if (!r) return;

  // Switch to correct tab
  if (r.tab) {
    const tabId = r.tab.id.replace('tab-', '');
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    r.tab.classList.add('active');
    document.querySelectorAll('.tab-btn').forEach(b => {
      if (b.textContent.toLowerCase().includes(tabId) || b.onclick.toString().includes(tabId)) {
        b.classList.add('active');
      }
    });
  }

  // Expand data section if collapsed
  if (r.isDataSection && r.header && r.body) {
    r.header.classList.remove('collapsed');
    r.body.classList.remove('collapsed');
  }

  // Scroll to element
  r.element.scrollIntoView({ behavior: 'smooth', block: 'start' });

  // Flash highlight
  r.element.style.outline = '3px solid var(--blue)';
  r.element.style.outlineOffset = '4px';
  r.element.style.borderRadius = '4px';
  setTimeout(() => {
    r.element.style.outline = '';
    r.element.style.outlineOffset = '';
  }, 2000);

  // Close results
  document.getElementById('searchResults').classList.remove('visible');
}

function escapeHtml(str) {
  if (!str) return '';
  return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

// Keyboard shortcut for search
document.addEventListener('keydown', function(e) {
  if ((e.ctrlKey || e.metaKey) && e.key === 'f') {
    e.preventDefault();
    document.getElementById('searchInput').focus();
  }
});

</script>
</body>
</html>
