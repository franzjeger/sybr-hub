  <div class="data-body">{{ teams_external }}</div>
</div>
{% endif %}

<!-- ══════════════════════════════════════════════════════════════════════ -->
<!-- ── 13. Apps & OAuth ── -->
<a name="apper"></a><h2 id="apper">{{ t.apps_oauth }}</h2>

{% if oauth and oauth.total_grants > 0 %}
<div class="summary-bar" style="grid-template-columns:repeat(3,1fr);">
