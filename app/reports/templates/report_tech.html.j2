</div>

</div><!-- /tab-identity -->

<div class="tab-panel" id="tab-email">
<!-- ══════════════════════════════════════════════════════════════════════ -->
<!-- ── 9. Email Security ── -->
<a name="epost"></a><h2 id="epost">{{ t.email_security }}</h2>
{% if spf_dmarc %}
<table>
  <tr><th>{{ t.domain }}</th><th>SPF</th><th>DMARC</th><th>DKIM sel1</th><th>DKIM sel2</th><th>MTA-STS</th></tr>
  {% for d in spf_dmarc %}
  <tr>
    <td style="font-weight:600;">{{ d.get('domain','') }}</td>
    <td>
      {% set s = d.get('spf','') %}
      <span class="tag {{ _severity(s) }}">{{ s.split('(')[0].strip() if '(' in s else s[:20] }}</span>
    </td>
    <td>
      {% set s = d.get('dmarc','') %}
      <span class="tag {{ _severity(s) }}">{{ s.split('(')[0].strip() if '(' in s else s[:20] }}</span>
    </td>
    <td style="font-size:11px;">{{ d.get('dkim1','')[:35] }}</td>
    <td style="font-size:11px;">{{ d.get('dkim2','')[:35] }}</td>
    <td>
      {% set s = d.get('mta_sts','') %}
      <span class="tag {% if 'MISSING' in s %}critical{% else %}ok{% endif %}">{{ s[:15] }}</span>
    </td>
  </tr>
  {% endfor %}
</table>
{% endif %}

<!-- ══════════════════════════════════════════════════════════════════════ -->
<!-- ── Exchange Online ── -->
{% if exchange and exchange.has_data %}
<a name="exchange"></a><h2 id="exchange">{{ t.exchange_online }}</h2>

<div class="summary-bar" style="grid-template-columns:repeat(4,1fr);">
  <div class="stat-box blue"><div class="num">{{ exchange.mailbox_total }}</div><div class="lbl">{{ t.mailboxes }}</div></div>
  <div class="stat-box blue"><div class="num">{{ exchange.transport_rules }}</div><div class="lbl">{{ t.transport_rules }}</div></div>
  <div class="stat-box {% if exchange.forwarding_count > 0 %}orange{% else %}green{% endif %}"><div class="num">{{ exchange.forwarding_count }}</div><div class="lbl">{{ t.forwarding }}</div></div>
  <div class="stat-box {% if exchange.external_forwarding %}red{% else %}green{% endif %}"><div class="num">{% if exchange.external_forwarding %}!{% else %}0{% endif %}</div><div class="lbl">{{ t.external_fwd_short }}</div></div>
</div>

{% if exchange.external_forwarding %}
<div class="alert critical"><strong>&#x1F534; {{ t.external_fwd_detected }}</strong>{{ t.external_fwd_desc }}</div>
{% endif %}

<div class="card">
  <div class="card-title">{{ t.mailbox_overview }}</div>
  <table>
    <tr><th>{{ t.type }}</th><th style="text-align:right;">{{ t.count_header }}</th></tr>
    <tr><td>{{ t.user_mailboxes }}</td><td style="text-align:right;font-family:var(--mono);">{{ exchange.mailbox_user }}</td></tr>
    <tr><td>{{ t.shared_mailboxes }}</td><td style="text-align:right;font-family:var(--mono);">{{ exchange.mailbox_shared }}</td></tr>
    <tr><td style="font-weight:600;">{{ t.total }}</td><td style="text-align:right;font-family:var(--mono);font-weight:600;">{{ exchange.mailbox_total }}</td></tr>
  </table>
</div>

{% if exchange.antiphish_policies %}
<h3>{{ t.antiphish_policies }} ({{ exchange.antiphish_policies | length }})</h3>
<table>
  <tr><th>{{ t.policy_name }}</th></tr>
  {% for p in exchange.antiphish_policies %}
  <tr><td>{{ p }}</td></tr>
  {% endfor %}
</table>
{% endif %}

{% if exchange.antispam_policies %}
<h3>{{ t.antispam_policies }} ({{ exchange.antispam_policies | length }})</h3>
<table>
  <tr><th>{{ t.policy_name }}</th></tr>
  {% for p in exchange.antispam_policies %}
  <tr><td>{{ p }}</td></tr>
  {% endfor %}
</table>
{% endif %}

<div class="card">
  <div class="card-title">{{ t.forwarding_and_connectors }}</div>
  <table>
    <tr><th>{{ t.setting }}</th><th style="text-align:right;">{{ t.value }}</th></tr>
    <tr><td>{{ t.mailbox_forwarding }}</td><td style="text-align:right;font-family:var(--mono);">{{ exchange.forwarding_count }}</td></tr>
    <tr>
      <td>{{ t.external_forwarding }}</td>
      <td style="text-align:right;">
        {% if exchange.external_forwarding %}<span class="tag critical">{{ t.detected }}</span>{% else %}<span class="tag ok">{{ t.none }}</span>{% endif %}
      </td>
    </tr>
    <tr><td>{{ t.inbox_rules_ext_fwd }}</td><td style="text-align:right;font-family:var(--mono);">{{ exchange.inbox_rules_external }}</td></tr>
    <tr><td>{{ t.transport_rules }}</td><td style="text-align:right;font-family:var(--mono);">{{ exchange.transport_rules }}</td></tr>
    <tr><td>{{ t.connectors }}</td><td style="text-align:right;font-family:var(--mono);">{{ exchange.connectors }}</td></tr>
  </table>
</div>

<!-- Exchange raw data sections -->
{# 28b_ and 29_..._WARN are the files that carry the actual findings; the
   collector renames 29_ rather than writing into it, so listing only the
   plain name left the raw evidence out of the appendix exactly when there
   was something to show. Missing keys are skipped by the guard below. #}
{% for key in ['20_exchange_mailboxes_count.txt', '21_exchange_transport_rules.txt', '22_exchange_connectors.txt', '23_exchange_antiphish.txt', '24_exchange_antispam.txt', '28_exchange_mailbox_forwarding.txt', '28b_exchange_external_forwarding_WARN.txt', '29_exchange_inbox_rules_external_fwd.txt', '29_exchange_inbox_rules_external_fwd_WARN.txt'] %}
{% if file_contents.get(key, '') and file_contents.get(key, '').strip() %}
<div class="data-section">
  <div class="data-header collapsed" onclick="toggleDataSection(this)">
    <span class="toggle">&#x25BC;</span>
    <span>{{ key.replace('.txt','').replace('_',' ').title() }}</span>
    <span class="fn">{{ key }}</span>
  </div>
  <div class="data-body collapsed">{{ file_contents.get(key, '') }}</div>
</div>
{% endif %}
{% endfor %}

{% endif %}

<!-- ══════════════════════════════════════════════════════════════════════ -->
<!-- ── 10. Secure Score ── -->
<a name="securescor"></a><h2 id="securescor">{{ t.ms_secure_score }}</h2>
<div class="card">
  <div class="card-grid">
    <div class="metric">
      <div class="num" style="color:{% if secure_score.pct >= 75 %}var(--green){% elif secure_score.pct >= 50 %}var(--orange){% else %}var(--red){% endif %}">{{ secure_score.current | round(0) | int }}</div>
      <div class="lbl">{{ t.points }}</div>
    </div>
    <div class="metric">
      <div class="num" style="color:var(--muted);">{{ secure_score.max | round(0) | int }}</div>
      <div class="lbl">{{ t.max_label }}</div>
    </div>
    <div class="metric">
      <div class="num">{{ secure_score.pct | round(1) }}%</div>
      <div class="lbl">{{ t.score }}</div>
    </div>
  </div>
  {% if secure_score.improvements %}
  <h3 style="margin-top:16px;">{{ t.top_improvements }}</h3>
  <table>
    <tr><th>{{ t.action_label }}</th><th style="text-align:right;width:80px;">{{ t.score_pct }}</th></tr>
    {% for imp in secure_score.improvements %}
    <tr>
      <td>{{ imp.name }}</td>
      <td style="text-align:right;font-family:var(--mono);">{{ imp.pct | round(1) }}%</td>
    </tr>
    {% endfor %}
  </table>
  {% endif %}
</div>

</div><!-- /tab-email -->

<div class="tab-panel" id="tab-devices">
<!-- ══════════════════════════════════════════════════════════════════════ -->
<!-- ── 11. Devices & Intune ── -->
<a name="enheter"></a><h2 id="enheter">{{ t.devices_intune }}</h2>

{% if intune and intune.total > 0 %}
<div class="summary-bar" style="grid-template-columns:repeat(6,1fr);">
  <div class="stat-box blue"><div class="num">{{ intune.total }}</div><div class="lbl">{{ t.total }}</div></div>
  <div class="stat-box blue"><div class="num">{{ intune.windows }}</div><div class="lbl">Windows</div></div>
  <div class="stat-box blue"><div class="num">{{ intune.ios }}</div><div class="lbl">iOS</div></div>
  <div class="stat-box blue"><div class="num">{{ intune.android }}</div><div class="lbl">Android</div></div>
  <div class="stat-box green"><div class="num">{{ intune.compliant }}</div><div class="lbl">{{ t.compliant_label }}</div></div>
  <div class="stat-box {% if intune.noncompliant > 0 %}red{% else %}green{% endif %}"><div class="num">{{ intune.noncompliant }}</div><div class="lbl">{{ t.noncompliant_label }}</div></div>
</div>

{% if intune.compliance_pct < 80 %}
<div class="alert warning"><strong>&#x26A0; {{ t('device_compliance_low', pct=intune.compliance_pct|round(0)|int) }}</strong>{{ t('device_compliance_low_desc', non=intune.noncompliant, total=intune.total) }}</div>
{% else %}
<div class="alert ok"><strong>&#x2713; {{ t('device_compliance_ok_pct', pct=intune.compliance_pct|round(0)|int) }}</strong></div>
{% endif %}

{% if intune.devices %}
<table>
  <tr><th>{{ t.device_name }}</th><th>{{ t.os_header }}</th><th>{{ t.user }}</th><th>{{ t.compliant_label }}</th><th>{{ t.enrolled }}</th></tr>
  {% for dev in intune.devices %}
  <tr>
    <td style="font-weight:500;">{{ dev.name }}</td>
    <td style="font-size:11px;">{{ dev.os }}</td>
    <td style="font-family:var(--mono);font-size:11px;">{{ dev.user }}</td>
    <td>
      {% if 'compliant' in dev.compliance.lower() and 'non' not in dev.compliance.lower() %}
      <span class="tag ok">{{ t.compliant_label }}</span>
      {% else %}
      <span class="tag critical">{{ t.noncompliant_label }}</span>
      {% endif %}
    </td>
    <td style="font-size:11px;">{{ dev.enrolled }}</td>
  </tr>
  {% endfor %}
</table>
{% endif %}

{% if compliance_policies and compliance_policies.strip() %}
{% if intune.entra_unmanaged is defined and intune.entra_unmanaged > 0 %}
<div class="alert warning"><strong>{{ t.unmanaged_endpoints }}</strong>{{ t.unmanaged_endpoints_desc }} — {{ intune.entra_unmanaged }} / {{ intune.entra_total }}</div>
{% endif %}
<h3>{{ t.compliance_policies_heading }}</h3>
<div class="data-section">
  <div class="data-header"><span>Intune Compliance Policies</span><span class="fn">11_intune_compliance_policies.txt</span></div>
  <div class="data-body">{{ compliance_policies }}</div>
</div>
{% endif %}
{% else %}
{% if intune and intune.unavailable %}
<div class="alert warning"><strong>{{ t.intune_not_measured }}</strong>{{ intune.unavailable_reason or t.no_intune_desc }}</div>
{% else %}
{% if entra_devices and entra_devices.has_data and entra_devices.total > 0 %}
<div class="alert warning"><strong>{{ t.no_intune_but_entra }}</strong>{{ t.no_intune_but_entra_desc }} ({{ entra_devices.total }})</div>
{% else %}
<div class="alert info"><strong>{{ t.no_intune_devices }}</strong>{{ t.no_intune_desc }}</div>
{% endif %}
{% endif %}
{% endif %}

</div><!-- /tab-devices -->

